/**
 * app.wxss — 米夏婚礼 · 极简雅白
 * 风格原则：白即奢华，金仅点睛，留白即设计
 */

page {
  /* ── 核心色 ── */
  --gold:        #C9A87C;
  --gold-deep:   #B8956E;
  --gold-line:   rgba(201, 168, 124, 0.28);

  /* ── 文字 ── */
  --ink:    #1A1714;   /* 标题 */
  --stone:  #706C68;   /* 正文 */
  --dust:   #AAA8A4;   /* 辅助 */

  /* ── 背景 ── */
  --paper:  #F8F5F1;   /* 页面底色，近乎白色的暖米 */
  --white:  #FFFFFF;   /* 卡片 */

  /* ── 边框 ── */
  --rule:   rgba(0, 0, 0, 0.07);   /* 细线 */

  /* ── 阴影 ── */
  --shadow-card:     0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  --shadow-elevated: 0 6rpx 28rpx rgba(0, 0, 0, 0.06);

  /* 向前兼容旧变量名（admin 页面使用）*/
  --primary-color:      #1A1714;
  --secondary-color:    #706C68;
  --text-color-regular: #1A1714;
  --text-color-light:   #AAA8A4;
  --bg-color-base:      #F8F5F1;
  --bg-color-card:      #FFFFFF;
  --price-color:        #C9A87C;
  --accent-color:       #E8C4B8;
  --accent-rose:        #D4A5A5;
  --border-color:       rgba(0, 0, 0, 0.07);
  --gradient-gold:      linear-gradient(135deg, #D4AF37 0%, #C9A87C 50%, #B8956E 100%);
  --gradient-rose:      linear-gradient(135deg, #E8C4B8 0%, #D4A5A5 100%);
  --gradient-warm:      linear-gradient(135deg, #F8F5F1 0%, #EDE8DF 100%);
  --shadow-soft:        0 1rpx 6rpx rgba(0, 0, 0, 0.04);
  --shadow-elevated-old: 0 6rpx 28rpx rgba(0, 0, 0, 0.06);

  /* ── 间距 ── */
  --margin-page:  32rpx;
  --margin-card:  20rpx;
  --padding-card: 40rpx;

  /* ── 圆角 ── */
  --border-radius-sm:   8rpx;
  --border-radius-card: 20rpx;
  --border-radius-lg:   48rpx;

  /* ── 字体 ── */
  --font-size-title:    44rpx;
  --font-size-base:     28rpx;
  --font-size-small:    24rpx;
  --font-size-price:    40rpx;
  --font-weight-bold:   500;
  --font-weight-regular:400;

  background:  var(--paper);
  color:       var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
               'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
  font-size:   var(--font-size-base);
  box-sizing:  border-box;
}

view, text, image, scroll-view, swiper, navigator {
  box-sizing: border-box;
}

/* ── 容器 ── */
.container {
  padding:        0 var(--margin-page);
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ── 卡片 ── */
.card {
  background:    var(--white);
  border-radius: var(--border-radius-card);
  border:        1rpx solid var(--rule);
  padding:       var(--padding-card);
  margin-bottom: var(--margin-card);
  position:      relative;
  overflow:      hidden;
}

/* 卡片顶部细线（金色，极淡）*/
.card::before {
  content:    '';
  position:   absolute;
  top: 0; left: 0; right: 0;
  height:     1rpx;
  background: linear-gradient(90deg, transparent 0%, var(--gold) 50%, transparent 100%);
  opacity:    0.25;
}

/* ── 文字工具类 ── */
.text-ellipsis {
  overflow:      hidden;
  text-overflow: ellipsis;
  white-space:   nowrap;
}

.text-ellipsis-2 {
  display:            -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow:           hidden;
}

/* ── 价格（金色渐变）── */
.price {
  font-size:               var(--font-size-price);
  font-weight:             500;
  background:              linear-gradient(135deg, #C9A87C 0%, #B8956E 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip:         text;
}

/* ── 动画 ── */
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes shimmer {
  0%   { background-position: -200% 0; }
  100% { background-position:  200% 0; }
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0.3; }
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

.animate-fade-in  { animation: fadeInUp 0.5s ease-out forwards; }
.animate-delay-1  { animation-delay: 0.08s; }
.animate-delay-2  { animation-delay: 0.16s; }
.animate-delay-3  { animation-delay: 0.24s; }
.animate-delay-4  { animation-delay: 0.32s; }

/* ── 通用装饰（供页面覆写）── */
.decorative-line {
  height:     1rpx;
  background: linear-gradient(90deg, transparent 0%, var(--gold) 50%, transparent 100%);
  opacity:    0.35;
}

/* 点阵：极简模式下全局隐藏 */
.decorative-dot { display: none; }

/* ── glass / hover（保留供局部使用）── */
.glass-effect {
  background:              rgba(255, 255, 255, 0.92);
  backdrop-filter:         blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.hover-scale {
  transition: transform 0.25s ease;
}

.hover-scale:active {
  transform: scale(0.975);
}
