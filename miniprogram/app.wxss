page {
  --primary-gold: #C9A96E;
  --primary-gold-light: #E8D5B5;
  --primary-gold-dark: #A68B4B;
  --accent-rose: #D4A5A5;
  --accent-rose-light: #F0E0E0;
  --bg-dark: #1A1A1A;
  --bg-light: #F8F8F8;
  --bg-card: #FFFFFF;
  --text-primary: #1A1A1A;
  --text-secondary: #666666;
  --text-muted: #999999;
  --text-light: #CCCCCC;
  --border-color: #EAEAEA;
  --shadow-xs: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  --shadow-sm: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 16rpx 48rpx rgba(0, 0, 0, 0.08);
  --shadow-xl: 0 24rpx 64rpx rgba(0, 0, 0, 0.12);
  --shadow-gold: 0 8rpx 32rpx rgba(201, 169, 110, 0.25);
  --shadow-gold-lg: 0 16rpx 48rpx rgba(201, 169, 110, 0.3);
  
  background-color: var(--bg-light);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-size: 26rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  line-height: 1.6;
}

.container {
  padding: 24rpx;
}

.primary-color {
  color: var(--primary-gold);
}

.primary-bg {
  background-color: var(--primary-gold);
}

.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

.flex {
  display: flex;
}

.flex-column {
  flex-direction: column;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-around {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.flex-1 {
  flex: 1;
}

.align-center {
  align-items: center;
}

.justify-center {
  justify-content: center;
}

.justify-between {
  justify-content: space-between;
}

.btn-primary {
  background: #111111;
  color: #ffffff;
  border-radius: 4rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  border: none;
  transition: all 0.3s ease;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  background: #333333;
}

.btn-outline {
  background-color: transparent;
  color: #111111;
  border: 1rpx solid #111111;
  border-radius: 4rpx;
  height: 88rpx;
  line-height: 86rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  transition: all 0.3s ease;
}

.btn-outline::after {
  border: none;
}

.btn-outline:active {
  background-color: rgba(0,0,0,0.05);
}

.card {
  background-color: var(--bg-card);
  border-radius: 8rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  transition: all 0.3s ease;
  border: 1rpx solid rgba(0,0,0,0.02);
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(201, 169, 110, 0.3), transparent);
  opacity: 0;
  transition: opacity 0.4s;
}

.card:active::before {
  opacity: 1;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 28rpx;
  padding-left: 24rpx;
  border-left: 4rpx solid var(--primary-gold);
  letter-spacing: 2rpx;
  position: relative;
}

.section-title::after {
  content: '';
  position: absolute;
  bottom: -6rpx;
  left: 24rpx;
  width: 32rpx;
  height: 2rpx;
  background: var(--primary-gold);
  opacity: 0.3;
}

.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  margin-right: 12rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  transition: all 0.3s ease;
}

.tag-primary {
  background: linear-gradient(135deg, rgba(201, 169, 110, 0.18) 0%, rgba(201, 169, 110, 0.08) 100%);
  color: var(--primary-gold-dark);
  border: 1rpx solid rgba(201, 169, 110, 0.3);
}

.tag-success {
  background: linear-gradient(135deg, rgba(82, 196, 26, 0.15) 0%, rgba(82, 196, 26, 0.05) 100%);
  color: #52C41A;
  border: 1rpx solid rgba(82, 196, 26, 0.3);
}

.tag-warning {
  background: linear-gradient(135deg, rgba(250, 173, 20, 0.15) 0%, rgba(250, 173, 20, 0.05) 100%);
  color: #D48806;
  border: 1rpx solid rgba(250, 173, 20, 0.3);
}

.tag-error {
  background: linear-gradient(135deg, rgba(245, 34, 45, 0.15) 0%, rgba(245, 34, 45, 0.05) 100%);
  color: #CF1322;
  border: 1rpx solid rgba(245, 34, 45, 0.3);
}

.text-primary {
  color: var(--primary-gold);
}

.text-success {
  color: #52C41A;
}

.text-warning {
  color: #FAAD14;
}

.text-error {
  color: #F5222D;
}

.text-muted {
  color: var(--text-muted);
}

.text-sm {
  font-size: 22rpx;
}

.text-lg {
  font-size: 32rpx;
}

.text-xl {
  font-size: 40rpx;
}

.font-bold {
  font-weight: 700;
}

.mt-10 {
  margin-top: 10rpx;
}

.mt-20 {
  margin-top: 20rpx;
}

.mt-30 {
  margin-top: 30rpx;
}

.mb-10 {
  margin-bottom: 10rpx;
}

.mb-20 {
  margin-bottom: 20rpx;
}

.mb-30 {
  margin-bottom: 30rpx;
}

.ml-10 {
  margin-left: 10rpx;
}

.ml-20 {
  margin-left: 20rpx;
}

.mr-10 {
  margin-right: 10rpx;
}

.mr-20 {
  margin-right: 20rpx;
}

.p-20 {
  padding: 20rpx;
}

.p-30 {
  padding: 30rpx;
}

.pt-20 {
  padding-top: 20rpx;
}

.pb-20 {
  padding-bottom: 20rpx;
}

.pl-20 {
  padding-left: 20rpx;
}

.pr-20 {
  padding-right: 20rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 28rpx;
  opacity: 0.6;
}

.empty-text {
  color: var(--text-muted);
  font-size: 26rpx;
  letter-spacing: 1rpx;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  color: var(--text-muted);
  font-size: 24rpx;
}

.divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent 0%, var(--border-color) 50%, transparent 100%);
  margin: 28rpx 0;
}

.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border-color);
  transition: all 0.3s ease;
}

.form-item:active {
  background-color: rgba(201, 169, 110, 0.02);
}

.form-label {
  width: 140rpx;
  color: var(--text-primary);
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.form-label.required::before {
  content: '*';
  color: #F5222D;
  margin-right: 4rpx;
}

.form-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
  letter-spacing: 1rpx;
}

.form-placeholder {
  color: var(--text-light);
}

.form-textarea {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
  min-height: 100rpx;
  letter-spacing: 1rpx;
}

.image-preview {
  width: 100%;
  height: 100%;
}

.status-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.status-pending {
  background: linear-gradient(135deg, rgba(250, 173, 20, 0.18) 0%, rgba(250, 173, 20, 0.08) 100%);
  color: #D48806;
  border: 1rpx solid rgba(250, 173, 20, 0.3);
}

.status-confirmed {
  background: linear-gradient(135deg, rgba(82, 196, 26, 0.18) 0%, rgba(82, 196, 26, 0.08) 100%);
  color: #389E0D;
  border: 1rpx solid rgba(82, 196, 26, 0.3);
}

.status-completed {
  background: linear-gradient(135deg, rgba(201, 169, 110, 0.18) 0%, rgba(201, 169, 110, 0.08) 100%);
  color: var(--primary-gold-dark);
  border: 1rpx solid rgba(201, 169, 110, 0.3);
}

.status-cancelled {
  background: linear-gradient(135deg, rgba(153, 153, 153, 0.15) 0%, rgba(153, 153, 153, 0.05) 100%);
  color: var(--text-muted);
  border: 1rpx solid rgba(153, 153, 153, 0.3);
}

.gold-gradient-text {
  background: linear-gradient(135deg, var(--primary-gold) 0%, var(--primary-gold-dark) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.rose-gradient-bg {
  background: linear-gradient(135deg, var(--accent-rose) 0%, #C49090 100%);
}

.gold-gradient-bg {
  background: linear-gradient(135deg, var(--primary-gold) 0%, var(--primary-gold-dark) 100%);
}

.dark-gradient-bg {
  background: linear-gradient(180deg, #2A2A2A 0%, #1A1A1A 100%);
}

.glass-effect {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.glass-effect-dark {
  background: rgba(26, 26, 26, 0.95);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.shimmer {
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

@keyframes shimmer {
  0% {
    background-position: -200% 0;
  }
  100% {
    background-position: 200% 0;
  }
}

.fade-in {
  animation: fadeIn 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.slide-up {
  animation: slideUp 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(100rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.scale-in {
  animation: scaleIn 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.pulse {
  animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}

.hover-lift {
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.hover-lift:active {
  transform: translateY(-4rpx);
  box-shadow: var(--shadow-lg);
}

.gradient-border {
  position: relative;
  background: var(--bg-card);
  border-radius: 24rpx;
}

.gradient-border::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 24rpx;
  padding: 2rpx;
  background: linear-gradient(135deg, var(--primary-gold), var(--accent-rose));
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
}

.text-gradient-gold {
  background: linear-gradient(135deg, var(--primary-gold) 0%, var(--primary-gold-light) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.shadow-glow {
  box-shadow: 0 0 40rpx rgba(201, 169, 110, 0.3);
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 10rpx;
  background: linear-gradient(135deg, #FF4D4F 0%, #CF1322 100%);
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 600;
  border-radius: 14rpx;
  position: absolute;
  top: -8rpx;
  right: -8rpx;
}

.badge-dot {
  width: 14rpx;
  height: 14rpx;
  background: linear-gradient(135deg, #FF4D4F 0%, #CF1322 100%);
  border-radius: 50%;
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  animation: pulse 2s infinite;
}

.ripple {
  position: relative;
  overflow: hidden;
}

.ripple::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  border-radius: 50%;
  background: rgba(201, 169, 110, 0.2);
  transform: translate(-50%, -50%);
  transition: width 0.6s, height 0.6s;
}

.ripple:active::after {
  width: 300%;
  height: 300%;
}
