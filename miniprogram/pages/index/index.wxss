/* ── 首页 · 极简雅白 ── */

.home-container {
  padding:    0;
  background: var(--paper);
  min-height: 100vh;
}

/* ─── 横幅 ─── */
.banner-section {
  width:    100%;
  height:   500rpx;
  overflow: hidden;
  position: relative;
}

.banner-image {
  width:  100%;
  height: 100%;
}

.banner-overlay {
  position:   absolute;
  inset:      0;
  background: linear-gradient(
    180deg,
    rgba(10, 8, 6, 0.20) 0%,
    rgba(10, 8, 6, 0.55) 100%
  );
}

.banner-content {
  position:        absolute;
  bottom:          80rpx;
  left:            0;
  right:           0;
  display:         flex;
  flex-direction:  column;
  align-items:     center;
  z-index:         2;
  gap:             12rpx;
}

.banner-title-wrap {
  display:        flex;
  flex-direction: column;
  align-items:    center;
  gap:            20rpx;
}

.banner-title {
  font-size:      62rpx;
  font-weight:    300;
  color:          #FFFFFF;
  letter-spacing: 22rpx;
  text-indent:    22rpx;
}

/* 横幅下方细线（唯一装饰线）*/
.banner-decorative-line {
  width:      80rpx;
  height:     1rpx;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
}

.banner-subtitle {
  font-size:      19rpx;
  color:          rgba(255, 255, 255, 0.65);
  letter-spacing: 18rpx;
  text-indent:    18rpx;
  text-transform: uppercase;
}

.banner-desc {
  font-size:      23rpx;
  color:          rgba(255, 255, 255, 0.55);
  letter-spacing: 8rpx;
  text-indent:    8rpx;
}

/* 横幅角标：不显示 */
.banner-corner-decor { display: none; }

/* ─── 导航 ─── */
.nav-section {
  position:      relative;
  z-index:       10;
  padding:       0 var(--margin-page);
  margin-top:    -32rpx;
  margin-bottom: 44rpx;
}

.nav-card {
  display:         flex;
  justify-content: space-around;
  padding:         52rpx 16rpx 48rpx;
  background:      var(--white);
  border-radius:   24rpx;
  box-shadow:      var(--shadow-elevated);
  border:          1rpx solid var(--rule);
  position:        relative;
  overflow:        hidden;
  /* 覆盖 glass-effect */
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
}

/* 导航卡顶部金线 */
.nav-card::before {
  content:    '';
  position:   absolute;
  top: 0; left: 0; right: 0;
  height:     1rpx;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
  opacity:    0.4;
}

.nav-item {
  display:        flex;
  flex-direction: column;
  align-items:    center;
}

.nav-icon-wrap {
  width:         88rpx;
  height:        88rpx;
  display:       flex;
  align-items:   center;
  justify-content: center;
  margin-bottom: 18rpx;
  position:      relative;
}

/* 图标圆圈：纯白底，极淡描边 */
.nav-icon-bg {
  position:      absolute;
  width:         100%;
  height:        100%;
  border-radius: 50%;
  background:    var(--paper);
  border:        1rpx solid var(--rule);
  transition:    background 0.2s;
}

.nav-icon-wrap.dress .nav-icon-bg,
.nav-icon-wrap.decoration .nav-icon-bg,
.nav-icon-wrap.car .nav-icon-bg,
.nav-icon-wrap.vendor .nav-icon-bg {
  background: var(--paper);
}

.nav-item:active .nav-icon-bg {
  background: rgba(201, 168, 124, 0.08);
}

.nav-icon {
  width:  48rpx;
  height: 48rpx;
  z-index: 2;
}

.nav-text {
  font-size:      22rpx;
  color:          var(--stone);
  font-weight:    400;
  letter-spacing: 5rpx;
  text-indent:    5rpx;
}

.nav-underline {
  width:         0;
  height:        1rpx;
  background:    var(--gold);
  margin-top:    10rpx;
  transition:    width 0.25s ease;
}

.nav-item:active .nav-underline {
  width: 28rpx;
}

/* ─── 精选推荐 ─── */
.recommend-section {
  padding:        0 var(--margin-page);
  padding-bottom: 100rpx;
}

.section-header {
  display:        flex;
  flex-direction: column;
  align-items:    center;
  margin-bottom:  44rpx;
  margin-top:     4rpx;
  text-align:     center;
}

/* 圆点装饰：隐藏 */
.section-decoration { display: none; }

.section-title-wrap {
  position: relative;
}

.section-title {
  font-size:      40rpx;
  font-weight:    300;
  color:          var(--ink);
  letter-spacing: 12rpx;
  text-indent:    12rpx;
}

/* 标题下方金线 */
.section-underline {
  width:      44rpx;
  height:     1rpx;
  background: var(--gold);
  margin:     14rpx auto 0;
  opacity:    0.6;
}

.section-subtitle {
  font-size:      17rpx;
  color:          var(--dust);
  letter-spacing: 10rpx;
  text-indent:    10rpx;
  text-transform: uppercase;
  margin-top:     12rpx;
}

/* ─── 推荐卡片 ─── */
.recommend-list {
  display:        flex;
  flex-direction: column;
  gap:            36rpx;
}

.recommend-card {
  padding:       0;
  overflow:      hidden;
  display:       flex;
  flex-direction: column;
  margin-bottom: 0;
  border-radius: var(--border-radius-card);
  border:        1rpx solid var(--rule);
  background:    var(--white);
  box-shadow:    var(--shadow-card);
  transition:    transform 0.25s ease;
}

.recommend-card:active {
  transform: scale(0.982);
}

.card-image-wrap {
  position:   relative;
  width:       100%;
  height:      460rpx;
  background:  #EEEBE6;
  overflow:    hidden;
}

.card-image {
  width:  100%;
  height: 100%;
}

/* 图片底部渐隐 */
.card-gradient {
  position:   absolute;
  bottom:     0;
  left:       0;
  right:      0;
  height:     80rpx;
  background: linear-gradient(to bottom, transparent, rgba(255,255,255,0.05));
}

/* 闪光：不显示 */
.card-shimmer { display: none; }

/* 分类标签 */
.card-tag {
  position:            absolute;
  top:                 24rpx;
  left:                24rpx;
  display:             flex;
  align-items:         center;
  gap:                 7rpx;
  background:          rgba(255, 255, 255, 0.88);
  backdrop-filter:     blur(10px);
  -webkit-backdrop-filter: blur(10px);
  padding:             9rpx 18rpx;
  border-radius:       32rpx;
  border:              1rpx solid rgba(255, 255, 255, 0.4);
}

.tag-icon {
  font-size: 12rpx;
  color:     var(--gold);
}

.tag-text {
  font-size:      19rpx;
  color:          var(--ink);
  letter-spacing: 2rpx;
}

/* 卡片内容区 */
.card-content {
  padding:    32rpx 28rpx 36rpx;
  background: var(--white);
}

.card-title {
  font-size:      31rpx;
  font-weight:    500;
  line-height:    1.55;
  color:          var(--ink);
  letter-spacing: 1rpx;
  margin-bottom:  20rpx;
}

.card-footer {
  display:         flex;
  justify-content: space-between;
  align-items:     center;
}

.price-wrap {
  display:     flex;
  align-items: baseline;
}

.price-symbol {
  font-size:    21rpx;
  color:        var(--gold);
  font-weight:  400;
  margin-right: 4rpx;
}

.price-value {
  font-size:               40rpx;
  font-weight:             500;
  background:              linear-gradient(135deg, #C9A87C 0%, #B8956E 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip:         text;
}

.price-range {
  font-size:   30rpx;
  color:       var(--gold);
  font-weight: 400;
}

/* "探索 →" */
.btn-more {
  display:        flex;
  align-items:    center;
  gap:            8rpx;
  font-size:      21rpx;
  color:          var(--stone);
  letter-spacing: 4rpx;
  text-indent:    4rpx;
  padding:        14rpx 28rpx;
  border:         1rpx solid var(--rule);
  border-radius:  var(--border-radius-lg);
}

.btn-text { }

.btn-arrow {
  font-size: 17rpx;
  color:     var(--gold);
}

/* ─── 空 / 错误状态 ─── */
.empty-state {
  display:         flex;
  flex-direction:  column;
  align-items:     center;
  justify-content: center;
  padding:         120rpx 0;
  gap:             0;
}

.empty-decoration { display: none; }
.empty-ring       { display: none; }
.empty-ring-inner { display: none; }

.empty-text {
  font-size:      24rpx;
  color:          var(--dust);
  letter-spacing: 6rpx;
  text-indent:    6rpx;
}
