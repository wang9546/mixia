.page-container {
  min-height: 100vh;
  background-color: #FAFAFA;
  padding-bottom: 160rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

/* Banner */
.banner-wrap {
  width: 100%;
  position: relative;
  background-color: #FFFFFF;
}

.banner-swiper {
  width: 100%;
  height: 600rpx;
  position: relative;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 50%;
  background: linear-gradient(to top, rgba(0,0,0,0.4) 0%, transparent 100%);
  pointer-events: none;
}

.banner-placeholder {
  width: 100%;
  height: 100%;
  background: #222222;
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-content {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.placeholder-brand {
  color: #B89C6D;
  font-family: 'Times New Roman', Times, serif;
  font-size: 60rpx;
  letter-spacing: 20rpx;
  margin-bottom: 16rpx;
  margin-left: 20rpx; /* offset for letter-spacing */
}

.placeholder-slogan {
  color: rgba(255,255,255,0.6);
  font-size: 20rpx;
  letter-spacing: 6rpx;
}

/* Services Section */
.services-section {
  padding: 100rpx 40rpx;
  background-color: #FAFAFA;
}

.section-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.sh-title {
  font-family: 'Times New Roman', Times, serif;
  font-size: 28rpx;
  color: #111111;
  letter-spacing: 8rpx;
  margin-left: 8rpx;
  margin-bottom: 12rpx;
}

.sh-subtitle {
  font-size: 20rpx;
  color: #999999;
  letter-spacing: 4rpx;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30rpx;
}

.service-card {
  background-color: #FFFFFF;
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 240rpx;
  border: 1rpx solid rgba(0,0,0,0.03);
  transition: all 0.3s ease;
}

.service-card:active {
  background-color: #FDFCF8;
  border-color: rgba(184, 156, 109, 0.3);
  transform: translateY(-2rpx);
}

.sc-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.sc-number {
  font-family: 'Times New Roman', Times, serif;
  font-size: 24rpx;
  color: #B89C6D;
}

.sc-arrow {
  font-size: 28rpx;
  color: #DDDDDD;
  font-weight: 300;
}

.sc-bottom {
  display: flex;
  flex-direction: column;
}

.sc-en {
  font-family: 'Times New Roman', Times, serif;
  font-size: 18rpx;
  color: #999999;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
  text-transform: uppercase;
}

.sc-name {
  font-size: 26rpx;
  color: #111111;
  font-weight: 400;
  letter-spacing: 2rpx;
}

/* Features Section */
.features-section {
  padding: 80rpx 40rpx 100rpx;
  background-color: #FFFFFF;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  padding: 40rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}

.feature-item:last-child {
  border-bottom: none;
}

.fi-icon {
  font-family: 'Times New Roman', Times, serif;
  font-size: 32rpx;
  color: #B89C6D;
  width: 80rpx;
  flex-shrink: 0;
}

.fi-content {
  display: flex;
  flex-direction: column;
}

.fi-title {
  font-size: 28rpx;
  color: #111111;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.fi-desc {
  font-size: 24rpx;
  color: #777777;
  line-height: 1.6;
  letter-spacing: 1rpx;
  font-weight: 300;
}

/* CTA Section */
.cta-section {
  padding: 0 40rpx 60rpx;
  background-color: #FFFFFF;
}

.cta-box {
  background-color: #1A1A1A;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  border-radius: 4rpx;
}

.cta-en {
  font-family: 'Times New Roman', Times, serif;
  font-size: 20rpx;
  color: #B89C6D;
  letter-spacing: 6rpx;
  margin-bottom: 16rpx;
  margin-left: 6rpx;
}

.cta-title {
  font-size: 36rpx;
  color: #FFFFFF;
  letter-spacing: 4rpx;
  margin-bottom: 40rpx;
}

.cta-line {
  width: 1rpx;
  height: 60rpx;
  background-color: rgba(255,255,255,0.2);
  margin-bottom: 40rpx;
}

.cta-btn {
  background-color: transparent;
  color: #FFFFFF;
  font-size: 26rpx;
  letter-spacing: 4rpx;
  padding: 0 60rpx;
  height: 80rpx;
  line-height: 80rpx;
  border: 1rpx solid rgba(255,255,255,0.4);
  border-radius: 0;
  transition: all 0.3s ease;
}

.cta-btn::after {
  border: none;
}

.cta-btn:active {
  background-color: #FFFFFF;
  color: #1A1A1A;
}
