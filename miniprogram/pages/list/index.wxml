<view class="container list-container">
  <view class="header-decoration">
    <view class="header-line"></view>
    <view class="header-dot"></view>
    <view class="header-line"></view>
  </view>

  <scroll-view class="tags-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}">
    <view class="tags-wrap">
      <view 
        class="tag-item {{currentTag === 'all' ? 'active' : ''}}" 
        bindtap="switchTag" 
        data-id="all">
        <text class="tag-text">全部</text>
        <view class="tag-indicator" wx:if="{{currentTag === 'all'}}"></view>
      </view>
      <block wx:for="{{tags}}" wx:key="_id">
        <view 
          class="tag-item {{currentTag === item._id ? 'active' : ''}}" 
          bindtap="switchTag" 
          data-id="{{item._id}}">
          <text class="tag-text">{{item.name}}</text>
          <view class="tag-indicator" wx:if="{{currentTag === item._id}}"></view>
        </view>
      </block>
    </view>
  </scroll-view>

  <view class="waterfall-list" wx:if="{{config.layout === 'waterfall'}}">
    <view class="waterfall-column">
      <block wx:for="{{leftList}}" wx:key="_id">
        <view class="card list-card hover-scale" bindtap="goToDetail" data-id="{{item._id}}">
          <view class="image-wrap">
            <image class="cover-image" src="{{item.cover_thumb || item[config.coverField] || '/images/home/banner.png'}}" mode="aspectFill" lazy-load="{{true}}"></image>
            <view class="image-overlay"></view>
            <view class="video-badge" wx:if="{{config.hasVideo && item.videos && item.videos.length > 0}}">
              <text class="video-icon">▶</text>
            </view>
          </view>
          <view class="card-info">
            <view class="title text-ellipsis-2">{{item[config.titleField]}}</view>
            <view class="style-tag" wx:if="{{config.styleTag && item.style}}">
              <text class="tag-star">✦</text>
              <text>{{item.style}}</text>
            </view>
            <view class="price-wrap" wx:if="{{config.priceField}}">
              <text class="price-label" wx:if="{{item[config.priceField]}}">¥</text>
              <text class="price-value" wx:if="{{item[config.priceField]}}">{{item[config.priceField] / 100}}</text>
              <text class="price-text" wx:if="{{item[config.priceField] === 0}}">面议</text>
            </view>
          </view>
        </view>
      </block>
    </view>
    <view class="waterfall-column">
      <block wx:for="{{rightList}}" wx:key="_id">
        <view class="card list-card hover-scale" bindtap="goToDetail" data-id="{{item._id}}">
          <view class="image-wrap">
            <image class="cover-image" src="{{item.cover_thumb || item[config.coverField] || '/images/home/banner.png'}}" mode="aspectFill" lazy-load="{{true}}"></image>
            <view class="image-overlay"></view>
            <view class="video-badge" wx:if="{{config.hasVideo && item.videos && item.videos.length > 0}}">
              <text class="video-icon">▶</text>
            </view>
          </view>
          <view class="card-info">
            <view class="title text-ellipsis-2">{{item[config.titleField]}}</view>
            <view class="style-tag" wx:if="{{config.styleTag && item.style}}">
              <text class="tag-star">✦</text>
              <text>{{item.style}}</text>
            </view>
            <view class="price-wrap" wx:if="{{config.priceField}}">
              <text class="price-label" wx:if="{{item[config.priceField]}}">¥</text>
              <text class="price-value" wx:if="{{item[config.priceField]}}">{{item[config.priceField] / 100}}</text>
              <text class="price-text" wx:if="{{item[config.priceField] === 0}}">面议</text>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view class="grid-list" wx:if="{{config.layout === 'grid'}}">
    <block wx:for="{{list}}" wx:key="_id">
      <view class="card grid-card hover-scale" bindtap="goToDetail" data-id="{{item._id}}">
        <view class="image-wrap">
          <image class="cover-image" src="{{item[config.coverField] || (item[config.imageField] && item[config.imageField][0]) || '/images/home/banner.png'}}" mode="aspectFill" lazy-load="{{true}}"></image>
          <view class="image-overlay"></view>
          <view class="card-badge">
            <text class="badge-icon">✦</text>
          </view>
        </view>
        <view class="card-info">
          <view class="title text-ellipsis">{{item[config.titleField]}}</view>
          <view class="sub-info" wx:if="{{config.subInfo}}">
            <text class="sub-dot">•</text>
            <text wx:if="{{item.color_name}}">{{item.color_name}}</text>
            <text wx:if="{{item.seats}}"> {{item.seats}}座</text>
          </view>
          <view class="price-wrap">
            <text class="price-label" wx:if="{{item[config.priceField]}}">¥</text>
            <text class="price-value" wx:if="{{item[config.priceField]}}">{{item[config.priceField] / 100}}</text>
            <text class="price-unit" wx:if="{{item[config.priceField] && config.priceUnit}}">{{config.priceUnit}}</text>
            <text class="price-text" wx:if="{{item[config.priceField] === 0}}">面议</text>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view class="horizontal-list" wx:if="{{config.layout === 'horizontal'}}">
    <block wx:for="{{list}}" wx:key="_id">
      <view class="card horizontal-card hover-scale" bindtap="goToDetail" data-id="{{item._id}}">
        <view class="avatar-wrap">
          <image class="avatar" src="{{item[config.coverField] || '/images/home/banner.png'}}" mode="aspectFill" lazy-load="{{true}}"></image>
          <view class="avatar-ring"></view>
        </view>
        <view class="card-info">
          <view class="title-wrap">
            <text class="title">{{item[config.titleField]}}</text>
            <view class="exp-tag" wx:if="{{config.vendorInfo && item.years_exp}}">
              <text class="exp-icon">✦</text>
              <text class="exp-text">从业{{item.years_exp}}年</text>
            </view>
          </view>
          <view class="desc text-ellipsis" wx:if="{{config.vendorInfo}}">{{item.service_desc || '暂无简介'}}</view>
          <view class="price-wrap">
            <text class="price-label" wx:if="{{item[config.priceField]}}">¥</text>
            <text class="price-value" wx:if="{{item[config.priceField]}}">{{item[config.priceField]}}</text>
            <text class="price-text" wx:if="{{item[config.priceField] === 0}}">面议</text>
          </view>
        </view>
        <view class="card-arrow">
          <text>→</text>
        </view>
      </view>
    </block>
  </view>

  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner">
      <view class="spinner-dot"></view>
      <view class="spinner-dot"></view>
      <view class="spinner-dot"></view>
    </view>
    <text class="loading-text">加载中...</text>
  </view>

  <view class="no-more" wx:if="{{!hasMore && list.length > 0}}">
    <view class="no-more-decoration">
      <view class="no-more-line"></view>
      <view class="no-more-dot"></view>
      <view class="no-more-line"></view>
    </view>
    <text class="no-more-text">没有更多了</text>
  </view>

  <view class="empty-state" wx:if="{{loadError}}">
    <view class="empty-icon-wrap">
      <view class="empty-ring-outer"></view>
      <view class="empty-ring-inner"></view>
      <text class="empty-icon">✦</text>
    </view>
    <text class="empty-text">加载失败，请下拉刷新重试</text>
  </view>

  <view class="empty-state" wx:if="{{list.length === 0 && !loading && !loadError}}">
    <view class="empty-icon-wrap">
      <view class="empty-ring-outer"></view>
      <view class="empty-ring-inner"></view>
      <text class="empty-icon">✦</text>
    </view>
    <text class="empty-text">{{config.emptyText}}</text>
  </view>
</view>