.page-container {
  min-height: 100vh;
  background-color: #F8F8F8;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 加载状态 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(201, 169, 110, 0.2);
  border-top-color: #C9A96E;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  color: #999999;
  font-size: 28rpx;
}

/* 区块 */
.section {
  background-color: #FFFFFF;
  margin-bottom: 24rpx;
  padding: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;
}

.section-header .section-title {
  margin-bottom: 0;
}

.add-btn-text {
  font-size: 26rpx;
  color: #C9A96E;
  letter-spacing: 1rpx;
}

/* 表单项 */
.form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #333333;
  flex-shrink: 0;
}

.form-label.required::before {
  content: '*';
  color: #F5222D;
  margin-right: 4rpx;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
  text-align: right;
}

.form-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.form-input.placeholder {
  color: #CCCCCC;
}

.form-textarea {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
  min-height: 120rpx;
  margin-top: 16rpx;
}

.arrow {
  color: #CCCCCC;
  margin-left: 8rpx;
}

/* 图片网格 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
  background-color: #F5F5F5;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-icon {
  color: #FFFFFF;
  font-size: 24rpx;
}

.add-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #CCCCCC;
}

.add-icon {
  font-size: 48rpx;
  color: #CCCCCC;
  margin-bottom: 8rpx;
}

.add-text {
  font-size: 22rpx;
  color: #999999;
}

/* 联系方式列表 */
.contact-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background-color: #F8F8F8;
  border-radius: 12rpx;
}

.contact-info {
  flex: 1;
}

.contact-label {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 6rpx;
}

.contact-value {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
}

.contact-actions {
  display: flex;
  gap: 24rpx;
}

.action-text {
  font-size: 26rpx;
  color: #C9A96E;
}

.action-text.delete {
  color: #F5222D;
}

.empty-tip {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  padding: 40rpx 0;
}

/* 保存按钮 */
.save-section {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx;
  background-color: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.save-btn {
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #C9A96E 0%, #A68B4B 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
  letter-spacing: 2rpx;
}

.save-btn::after {
  border: none;
}

.save-btn.disabled {
  opacity: 0.6;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 90%;
  max-width: 600rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  padding: 32rpx;
  text-align: center;
  border-bottom: 1rpx solid #F0F0F0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.modal-body {
  padding: 32rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.modal-form-item {
  margin-bottom: 28rpx;
}

.modal-form-item:last-child {
  margin-bottom: 0;
}

.modal-label {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.modal-label.required::before {
  content: '*';
  color: #F5222D;
  margin-right: 4rpx;
}

.modal-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background-color: #F8F8F8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1A1A1A;
}

.picker-input {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  padding: 0 24rpx;
  background-color: #F8F8F8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1A1A1A;
}

.qrcode-preview {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: #F8F8F8;
}

.qrcode-image {
  width: 100%;
  height: 100%;
}

.choose-btn {
  display: inline-block;
  padding: 16rpx 32rpx;
  background-color: #F8F8F8;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #C9A96E;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #F0F0F0;
}

.modal-btn {
  flex: 1;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  font-size: 30rpx;
}

.modal-btn.cancel {
  color: #666666;
  border-right: 1rpx solid #F0F0F0;
}

.modal-btn.confirm {
  color: #C9A96E;
  font-weight: 600;
}
