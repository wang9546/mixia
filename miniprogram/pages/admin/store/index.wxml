<view class="store-container">
  <form bindsubmit="onSubmit">
    <!-- 基本信息 -->
    <view class="form-section">
      <view class="section-title">基本信息</view>
      
      <view class="form-item">
        <text class="form-label">门店名称</text>
        <input class="form-input" name="name" value="{{formData.name}}" placeholder="请输入门店名称" />
      </view>
      
      <view class="form-item">
        <text class="form-label">昵称</text>
        <input class="form-input" name="wechat" value="{{formData.wechat}}" placeholder="请输入昵称" />
      </view>

      <view class="form-item">
        <text class="form-label">联系人</text>
        <view class="phone-list">
          <view class="phone-item" wx:for="{{formData.phones}}" wx:key="index">
            <input class="form-input phone-input" value="{{item}}" bindinput="onPhoneInput" data-index="{{index}}" placeholder="请输入联系人" />
            <view class="phone-delete" bindtap="deletePhone" data-index="{{index}}">×</view>
          </view>
        </view>
        <button class="add-phone-btn" bindtap="addPhone">+ 添加联系人</button>
      </view>
      
      <view class="form-item">
        <text class="form-label">门店地址</text>
        <input class="form-input" name="address" value="{{formData.address}}" placeholder="请输入门店地址" />
      </view>
      
      <view class="form-item">
        <text class="form-label">营业时间</text>
        <input class="form-input" name="business_hours" value="{{formData.business_hours}}" placeholder="如：09:00 - 18:00" />
      </view>
      
      <view class="form-item">
        <text class="form-label">门店简介</text>
        <textarea class="form-textarea" name="description" value="{{formData.description}}" placeholder="请输入门店简介" maxlength="500" />
      </view>
    </view>

    <!-- 地理位置设置 -->
    <view class="form-section">
      <view class="section-title">地理位置</view>
      <view class="location-info">
        <view class="location-item">
          <text class="location-label">经度</text>
          <text class="location-value">{{formData.longitude || '未设置'}}</text>
        </view>
        <view class="location-item">
          <text class="location-label">纬度</text>
          <text class="location-value">{{formData.latitude || '未设置'}}</text>
        </view>
      </view>
      <button class="location-btn" bindtap="chooseLocation">选择位置</button>
    </view>

    <!-- 门店图片 -->
    <view class="form-section">
      <view class="section-title">门店图片</view>
      <view class="image-upload">
        <view class="image-item" wx:for="{{formData.images}}" wx:key="*this">
          <image src="{{item}}" mode="aspectFill" bindtap="previewImage" data-url="{{item}}"></image>
          <view class="delete-btn" bindtap="deleteImage" data-index="{{index}}">×</view>
        </view>
        <view class="upload-btn" bindtap="uploadImage">
          <text>+</text>
          <text class="upload-text">添加图片</text>
        </view>
      </view>
    </view>

    <!-- 状态设置 -->
    <view class="form-section">
      <view class="section-title">状态设置</view>
      <view class="form-item switch-item">
        <text class="form-label">是否启用</text>
        <switch checked="{{formData.is_active}}" bindchange="onSwitchChange" color="#667eea" />
      </view>
    </view>

    <!-- 提交按钮 -->
    <view class="form-actions">
      <button class="submit-btn" form-type="submit">保存</button>
    </view>
  </form>
</view>
