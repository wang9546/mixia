.admin-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FDF9F6 0%, #F8F4F0 50%, #F5EFE8 100%);
  padding-bottom: 60rpx;
}

.admin-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 32rpx 48rpx;
  position: relative;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(232, 196, 184, 0.2) 0%, rgba(212, 165, 165, 0.2) 50%, rgba(201, 168, 124, 0.15) 100%);
}

.header-decoration {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
  z-index: 2;
}

.header-decoration.bottom {
  margin-top: 24rpx;
  margin-bottom: 0;
}

.decor-line-left {
  width: 60rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, rgba(201, 168, 124, 0.6) 100%);
}

.decor-line-right {
  width: 60rpx;
  height: 2rpx;
  background: linear-gradient(90deg, rgba(201, 168, 124, 0.6) 0%, transparent 100%);
}

.decor-dot {
  width: 10rpx;
  height: 10rpx;
  background: var(--price-color);
  border-radius: 50%;
  box-shadow: 0 0 8rpx rgba(201, 168, 124, 0.5);
}

.header-title {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--primary-color);
  letter-spacing: 8rpx;
  z-index: 2;
}

.header-subtitle {
  font-size: 28rpx;
  color: var(--secondary-color);
  letter-spacing: 4rpx;
  z-index: 2;
  margin-top: 12rpx;
}

.header-en {
  font-size: 22rpx;
  color: var(--text-color-light);
  letter-spacing: 12rpx;
  text-transform: uppercase;
  z-index: 2;
  margin-top: 8rpx;
}

.section {
  margin: 0 24rpx 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.section-decoration {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.decor-line {
  width: 48rpx;
  height: 2rpx;
  background: linear-gradient(90deg, rgba(201, 168, 124, 0.3) 0%, rgba(201, 168, 124, 0.8) 100%);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--primary-color);
  letter-spacing: 6rpx;
}

.menu-list {
  padding: 0 32rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FDF9F6 100%);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
}

.menu-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  margin-right: 24rpx;
  border: 1rpx solid rgba(201, 168, 124, 0.2);
}

.menu-icon-wrap.dress {
  background: linear-gradient(135deg, rgba(232, 196, 184, 0.3) 0%, rgba(255, 215, 180, 0.2) 100%);
}

.menu-icon-wrap.decoration {
  background: linear-gradient(135deg, rgba(212, 165, 165, 0.3) 0%, rgba(180, 140, 140, 0.2) 100%);
}

.menu-icon-wrap.car {
  background: linear-gradient(135deg, rgba(201, 168, 124, 0.3) 0%, rgba(180, 150, 100, 0.2) 100%);
}

.menu-icon-wrap.vendor {
  background: linear-gradient(135deg, rgba(212, 180, 165, 0.3) 0%, rgba(190, 160, 145, 0.2) 100%);
}

.menu-icon-wrap.tag {
  background: linear-gradient(135deg, rgba(201, 168, 124, 0.25) 0%, rgba(184, 149, 110, 0.2) 100%);
}

.menu-icon-wrap.store {
  background: linear-gradient(135deg, rgba(232, 196, 184, 0.25) 0%, rgba(212, 165, 165, 0.2) 100%);
}

.menu-icon-wrap.user {
  background: linear-gradient(135deg, rgba(212, 165, 165, 0.25) 0%, rgba(180, 140, 140, 0.2) 100%);
}

.menu-icon {
  font-size: 20rpx;
  color: var(--price-color);
}

.menu-content {
  flex: 1;
  min-width: 0;
}

.menu-text {
  display: block;
  font-size: 30rpx;
  color: var(--primary-color);
  font-weight: 500;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.menu-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-color-light);
  letter-spacing: 1rpx;
}

.menu-arrow-wrap {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-arrow {
  font-size: 24rpx;
  color: var(--price-color);
  opacity: 0.6;
}

.menu-divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent 0%, rgba(201, 168, 124, 0.15) 50%, transparent 100%);
  margin: 0 16rpx;
}

.footer-decoration {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 48rpx 0;
}

.footer-line {
  width: 80rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, rgba(201, 168, 124, 0.4) 50%, transparent 100%);
}

.footer-dot {
  width: 8rpx;
  height: 8rpx;
  background: var(--price-color);
  border-radius: 50%;
  opacity: 0.6;
}