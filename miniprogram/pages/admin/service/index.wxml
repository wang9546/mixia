<view class="page-container">
  <view class="menu-section">
    <view class="menu-group" wx:for="{{menuList}}" wx:key="id">
      <view class="menu-header" bindtap="onMenuTap" data-id="{{item.id}}">
        <view class="menu-icon">{{item.icon}}</view>
        <text class="menu-name">{{item.name}}</text>
        <text class="menu-arrow {{expandedMenu === item.id ? 'expanded' : ''}}">▼</text>
      </view>
      <view class="menu-children {{expandedMenu === item.id ? 'show' : ''}}">
        <view 
          class="menu-child-item" 
          wx:for="{{item.children}}" 
          wx:for-item="child" 
          wx:key="id"
          bindtap="onSubmenuTap"
          data-url="{{child.url}}"
        >
          <text class="child-name">{{child.name}}</text>
          <text class="child-arrow">→</text>
        </view>
      </view>
    </view>
  </view>
</view>
