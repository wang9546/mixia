<view class="page-container">
  <view class="header-bar">
    <text class="header-title">婚车管理</text>
    <button class="add-btn" bindtap="onAddTap">+ 新增</button>
  </view>

  <view class="list-section" wx:if="{{!loading}}">
    <view class="list-item" wx:for="{{list}}" wx:key="_id">
      <view class="item-content">
        <image wx:if="{{item.coverImage}}" class="item-cover" src="{{item.coverImage}}" mode="aspectFill"></image>
        <view wx:else class="item-cover-placeholder">🚗</view>
        <view class="item-info">
          <text class="item-name">{{item.name}}</text>
          <view class="item-meta">
            <text class="item-brand" wx:if="{{item.brandInfo}}">{{item.brandInfo.name}}</text>
            <text class="item-color" wx:if="{{item.colorInfo}}">{{item.colorInfo.name}}</text>
          </view>
          <text class="item-price" wx:if="{{item.price}}">¥{{item.price}}/{{item.priceUnit || '天'}}</text>
        </view>
        <view class="item-status {{item.status === 1 ? 'active' : 'inactive'}}">
          {{item.status === 1 ? '启用' : '禁用'}}
        </view>
      </view>
      <view class="item-actions">
        <button class="action-btn edit" bindtap="onEditTap" data-item="{{item}}">编辑</button>
        <button class="action-btn delete" bindtap="onDeleteTap" data-item="{{item}}">删除</button>
      </view>
    </view>

    <view class="empty-state" wx:if="{{list.length === 0}}">
      <text class="empty-text">暂无数据</text>
    </view>
  </view>

  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <view class="form-modal" wx:if="{{showForm}}">
    <view class="form-mask" bindtap="onCloseForm"></view>
    <scroll-view class="form-content" scroll-y="{{true}}">
      <view class="form-header">
        <text class="form-title">{{editingItem ? '编辑' : '新增'}}婚车</text>
        <text class="form-close" bindtap="onCloseForm">×</text>
      </view>
      
      <view class="form-body">
        <view class="form-item">
          <text class="form-label">车型名称 *</text>
          <input class="form-input" value="{{formData.name}}" bindinput="onInputChange" data-key="name" placeholder="请输入车型名称" />
        </view>
        
        <view class="form-item">
          <text class="form-label">品牌</text>
          <picker mode="selector" range="{{brands}}" range-key="name" bindchange="onBrandChange" value="{{brandIndex}}">
            <view class="form-picker">
              <text>{{brands[brandIndex].name}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>
        
        <view class="form-item">
          <text class="form-label">颜色</text>
          <picker mode="selector" range="{{colors}}" range-key="name" bindchange="onColorChange" value="{{colorIndex}}">
            <view class="form-picker">
              <text>{{colors[colorIndex].name}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>
        
        <view class="form-item">
          <text class="form-label">封面图</text>
          <view class="image-picker" bindtap="onCoverChoose">
            <image wx:if="{{formData.coverImage}}" class="preview-image" src="{{formData.coverImage}}" mode="aspectFill"></image>
            <view wx:else class="image-placeholder">+ 上传封面</view>
          </view>
        </view>
        
        <view class="form-item">
          <text class="form-label">轮播图</text>
          <view class="images-grid">
            <view class="image-item" wx:for="{{images}}" wx:key="index">
              <image class="grid-image" src="{{item}}" mode="aspectFill"></image>
              <view class="image-remove" bindtap="onImageRemove" data-index="{{index}}">×</view>
            </view>
            <view class="image-add" bindtap="onImagesChoose" wx:if="{{images.length < 9}}">
              <text class="add-text">+</text>
            </view>
          </view>
        </view>
        
        <view class="form-item">
          <text class="form-label">价格</text>
          <view class="price-row">
            <input class="form-input price-input" type="digit" value="{{formData.price}}" bindinput="onInputChange" data-key="price" placeholder="请输入价格" />
            <picker mode="selector" range="{{['天', '次']}}" bindchange="onUnitChange" value="{{formData.priceUnit === '天' ? 0 : 1}}">
              <view class="unit-picker">{{formData.priceUnit || '天'}}</view>
            </picker>
          </view>
        </view>
        
        <view class="form-item">
          <text class="form-label">备注</text>
          <textarea class="form-textarea" value="{{formData.remark}}" bindinput="onInputChange" data-key="remark" placeholder="请输入备注"></textarea>
        </view>
        
        <view class="form-item">
          <text class="form-label">排序</text>
          <input class="form-input" type="number" value="{{formData.sort}}" bindinput="onInputChange" data-key="sort" placeholder="数字越小越靠前" />
        </view>
        
        <view class="form-item">
          <text class="form-label">状态</text>
          <switch checked="{{formData.status === 1}}" bindchange="onSwitchChange" data-key="status" />
        </view>
      </view>
      
      <view class="form-footer">
        <button class="form-btn cancel" bindtap="onCloseForm">取消</button>
        <button class="form-btn submit" bindtap="onSubmit">保存</button>
      </view>
    </scroll-view>
  </view>
</view>
