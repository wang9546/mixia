.page-container {
  min-height: 100vh;
  background-color: #F5F6F8;
  padding-bottom: 120rpx;
}

.filter-section {
  background-color: #FFFFFF;
  padding: 16rpx 0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.filter-row {
  padding: 8rpx 0;
}

.filter-scroll {
  white-space: nowrap;
}

.filter-list {
  display: inline-flex;
  padding: 0 32rpx;
  gap: 16rpx;
}

.filter-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  color: #666666;
  background-color: #F5F6F8;
  border-radius: 28rpx;
}

.filter-item.active {
  background: linear-gradient(135deg, #C9A96E 0%, #A68B4B 100%);
  color: #FFFFFF;
  font-weight: 500;
}

.list-section {
  padding: 24rpx;
}

.list-count {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 20rpx;
}

.staff-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.staff-item {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
}

.staff-main {
  display: flex;
  margin-bottom: 20rpx;
}

.staff-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background-color: #F5F5F5;
}

.staff-info {
  flex: 1;
}

.staff-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.staff-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.staff-title {
  font-size: 22rpx;
  color: #C9A96E;
  background: rgba(201, 169, 110, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.staff-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.status-active {
  color: #52C41A;
  background: rgba(82, 196, 26, 0.1);
}

.status-inactive {
  color: #999999;
  background: rgba(153, 153, 153, 0.1);
}

.status-vacation {
  color: #FAAD14;
  background: rgba(250, 173, 20, 0.1);
}

.staff-meta {
  display: flex;
  gap: 20rpx;
  margin-bottom: 8rpx;
}

.meta-item {
  font-size: 26rpx;
  color: #666666;
}

.staff-contact {
  display: flex;
  font-size: 26rpx;
}

.contact-label {
  color: #999999;
}

.contact-value {
  color: #666666;
}

.staff-actions {
  display: flex;
  gap: 16rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0F0F0;
}

.action-btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  border-radius: 8rpx;
}

.edit-btn {
  background-color: #F5F6F8;
  color: #666666;
}

.delete-btn {
  background-color: rgba(255, 77, 79, 0.1);
  color: #FF4D4F;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  gap: 16rpx;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(201, 169, 110, 0.2);
  border-top-color: #C9A96E;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  color: #999999;
  font-size: 26rpx;
}

.no-more {
  text-align: center;
  padding: 40rpx 0;
}

.no-more-text {
  color: #999999;
  font-size: 24rpx;
}

.add-btn {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: linear-gradient(135deg, #C9A96E 0%, #A68B4B 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 44rpx;
  box-shadow: 0 8rpx 24rpx rgba(201, 169, 110, 0.3);
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 680rpx;
  max-height: 80vh;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
  flex-shrink: 0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.modal-close {
  font-size: 40rpx;
  color: #999999;
  line-height: 1;
}

.modal-body {
  padding: 32rpx;
  max-height: 60vh;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 12rpx;
}

.form-label.required::before {
  content: '*';
  color: #FF4D4F;
  margin-right: 4rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  border: 1rpx solid #E8E8E8;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.form-picker {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  border: 1rpx solid #E8E8E8;
  border-radius: 12rpx;
  box-sizing: border-box;
  color: #333333;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  border: 1rpx solid #E8E8E8;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.style-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.style-item {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #666666;
  background-color: #F5F6F8;
  border-radius: 24rpx;
}

.style-item.active {
  background: linear-gradient(135deg, #C9A96E 0%, #A68B4B 100%);
  color: #FFFFFF;
}

.radio-group {
  display: flex;
  gap: 32rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #333333;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #F0F0F0;
  flex-shrink: 0;
}

.btn-cancel, .btn-confirm {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 30rpx;
  border: none;
  border-radius: 0;
  background-color: transparent;
}

.btn-cancel {
  color: #666666;
  border-right: 1rpx solid #F0F0F0;
}

.btn-confirm {
  color: #C9A96E;
  font-weight: 500;
}

.btn-cancel::after, .btn-confirm::after {
  border: none;
}

.works-btn {
  background-color: rgba(201, 169, 110, 0.1);
  color: #C9A96E;
}

.works-modal {
  width: 720rpx;
  max-height: 85vh;
}

.works-section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 20rpx;
}

.staff-works-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.staff-work-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  background-color: #F5F6F8;
  border-radius: 12rpx;
}

.work-cover {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  background-color: #E8E8E8;
}

.work-info {
  flex: 1;
}

.work-title {
  display: block;
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 8rpx;
}

.work-type {
  display: block;
  font-size: 24rpx;
  color: #999999;
}

.work-remove {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 32rpx;
  color: #FF4D4F;
  background-color: rgba(255, 77, 79, 0.1);
  border-radius: 50%;
}

.empty-works {
  text-align: center;
  padding: 40rpx 0;
  color: #999999;
  font-size: 26rpx;
}

.work-type-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.type-tab {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #666666;
  background-color: #F5F6F8;
  border-radius: 24rpx;
}

.type-tab.active {
  background: linear-gradient(135deg, #C9A96E 0%, #A68B4B 100%);
  color: #FFFFFF;
}

.available-works-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.available-work-item {
  position: relative;
  border-radius: 12rpx;
  overflow: hidden;
  border: 2rpx solid transparent;
}

.available-work-item.selected {
  border-color: #C9A96E;
}

.work-thumb {
  width: 100%;
  height: 160rpx;
  background-color: #E8E8E8;
}

.work-checkbox {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.9);
  border: 2rpx solid #E8E8E8;
}

.available-work-item.selected .work-checkbox {
  background-color: #C9A96E;
  border-color: #C9A96E;
}

.available-work-item.selected .work-checkbox::after {
  content: '✓';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: #FFFFFF;
  font-size: 20rpx;
}

.work-name {
  display: block;
  padding: 8rpx;
  font-size: 22rpx;
  color: #333333;
  background-color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
