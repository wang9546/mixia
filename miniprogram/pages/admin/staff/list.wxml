<view class="page-container">
  <view class="filter-section">
    <view class="filter-row">
      <scroll-view class="filter-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="filter-list">
          <view 
            class="filter-item {{currentType === item.id ? 'active' : ''}}" 
            wx:for="{{staffTypes}}" 
            wx:key="id"
            bindtap="onTypeChange"
            data-id="{{item.id}}"
          >
            {{item.name}}
          </view>
        </view>
      </scroll-view>
    </view>
    <view class="filter-row">
      <scroll-view class="filter-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="filter-list">
          <view 
            class="filter-item {{currentStatus === item.id ? 'active' : ''}}" 
            wx:for="{{statusList}}" 
            wx:key="id"
            bindtap="onStatusChange"
            data-id="{{item.id}}"
          >
            {{item.name}}
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="list-section">
    <view class="list-count" wx:if="{{total > 0}}">共 {{total}} 人</view>
    
    <view class="staff-list" wx:if="{{list.length > 0}}">
      <view class="staff-item" wx:for="{{list}}" wx:key="_id">
        <view class="staff-main">
          <image class="staff-avatar" src="{{item.avatarUrl || item.avatar || '/images/icons/avatar.png'}}" mode="aspectFill"></image>
          <view class="staff-info">
            <view class="staff-header">
              <text class="staff-name">{{item.name}}</text>
              <text class="staff-title" wx:if="{{item.title}}">{{item.title}}</text>
              <text class="staff-status {{getStatusClass(item.status)}}">{{getStatusName(item.status)}}</text>
            </view>
            <view class="staff-meta">
              <text class="meta-item">{{getTypeName(item.typeId)}}</text>
              <text class="meta-item" wx:if="{{item.experience}}">{{item.experience}}年经验</text>
            </view>
            <view class="staff-contact" wx:if="{{item.phone}}">
              <text class="contact-label">电话：</text>
              <text class="contact-value">{{item.phone}}</text>
            </view>
          </view>
        </view>
        <view class="staff-actions">
          <view class="action-btn works-btn" bindtap="onWorksTap" data-item="{{item}}">作品</view>
          <view class="action-btn edit-btn" bindtap="onEditTap" data-item="{{item}}">编辑</view>
          <view class="action-btn delete-btn" bindtap="onDeleteTap" data-id="{{item._id}}">删除</view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{!loading && list.length === 0}}">
      <text class="empty-icon">👥</text>
      <text class="empty-text">暂无人员数据</text>
    </view>

    <view class="loading-more" wx:if="{{loadingMore}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <view class="no-more" wx:if="{{noMore && list.length > 0}}">
      <text class="no-more-text">已经到底了</text>
    </view>
  </view>

  <view class="add-btn" bindtap="onAddTap">+ 添加人员</view>

  <view class="modal-mask" wx:if="{{showAddModal}}" bindtap="closeModal">
    <view class="modal-content" catchtap="">
      <view class="modal-header">
        <text class="modal-title">{{editingStaff ? '编辑人员' : '添加人员'}}</text>
        <text class="modal-close" bindtap="closeModal">×</text>
      </view>
      
      <scroll-view class="modal-body" scroll-y="{{true}}">
        <view class="form-item">
          <text class="form-label required">姓名</text>
          <input class="form-input" placeholder="请输入姓名" value="{{formData.name}}" bindinput="onFormInput" data-field="name" />
        </view>
        
        <view class="form-item">
          <text class="form-label required">类型</text>
          <picker mode="selector" range="{{staffTypes}}" range-key="name" value="{{staffTypes.findIndex(t => t.id === formData.typeId)}}" bindchange="onFormTypeChange">
            <view class="form-picker">{{getTypeName(formData.typeId) || '请选择类型'}}</view>
          </picker>
        </view>
        
        <view class="form-item">
          <text class="form-label">职称</text>
          <input class="form-input" placeholder="如：首席、资深" value="{{formData.title}}" bindinput="onFormInput" data-field="title" />
        </view>
        
        <view class="form-item">
          <text class="form-label required">联系电话</text>
          <input class="form-input" type="number" placeholder="请输入联系电话" value="{{formData.phone}}" bindinput="onFormInput" data-field="phone" />
        </view>
        
        <view class="form-item">
          <text class="form-label">从业年限</text>
          <input class="form-input" type="number" placeholder="请输入从业年限" value="{{formData.experience}}" bindinput="onFormInput" data-field="experience" />
        </view>
        
        <view class="form-item">
          <text class="form-label">擅长风格</text>
          <view class="style-list">
            <view 
              class="style-item {{formData.styles.indexOf(item._id) > -1 ? 'active' : ''}}" 
              wx:for="{{allStyles}}" 
              wx:key="_id"
              bindtap="onStyleChange"
              data-id="{{item._id}}"
            >
              {{item.name}}
            </view>
          </view>
        </view>
        
        <view class="form-item">
          <text class="form-label">个人简介</text>
          <textarea class="form-textarea" placeholder="请输入个人简介" value="{{formData.introduction}}" bindinput="onFormInput" data-field="introduction" />
        </view>
        
        <view class="form-item">
          <text class="form-label">状态</text>
          <radio-group class="radio-group" bindchange="onFormStatusChange">
            <label class="radio-item">
              <radio value="active" checked="{{formData.status === 'active'}}" />
              <text>在职</text>
            </label>
            <label class="radio-item">
              <radio value="vacation" checked="{{formData.status === 'vacation'}}" />
              <text>休假</text>
            </label>
            <label class="radio-item">
              <radio value="inactive" checked="{{formData.status === 'inactive'}}" />
              <text>离职</text>
            </label>
          </radio-group>
        </view>
      </scroll-view>
      
      <view class="modal-footer">
        <button class="btn-cancel" bindtap="closeModal">取消</button>
        <button class="btn-confirm" bindtap="saveStaff">保存</button>
      </view>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{showWorksModal}}" bindtap="closeWorksModal">
    <view class="modal-content works-modal" catchtap="">
      <view class="modal-header">
        <text class="modal-title">配置作品 - {{editingStaff.name}}</text>
        <text class="modal-close" bindtap="closeWorksModal">×</text>
      </view>
      
      <scroll-view class="modal-body" scroll-y="{{true}}">
        <view class="works-section">
          <view class="section-title">已关联作品</view>
          <view class="staff-works-list" wx:if="{{staffWorks.length > 0}}">
            <view class="staff-work-item" wx:for="{{staffWorks}}" wx:key="_id">
              <image class="work-cover" src="{{item.workCover}}" mode="aspectFill"></image>
              <view class="work-info">
                <text class="work-title">{{item.workTitle}}</text>
                <text class="work-type">{{getWorkTypeName(item.workType)}}</text>
              </view>
              <view class="work-remove" bindtap="onWorkRemove" data-id="{{item._id}}">×</view>
            </view>
          </view>
          <view class="empty-works" wx:else>
            <text>暂无关联作品</text>
          </view>
        </view>

        <view class="works-section">
          <view class="section-title">添加作品</view>
          <view class="work-type-tabs">
            <view 
              class="type-tab {{currentWorkType === item.id ? 'active' : ''}}" 
              wx:for="{{workTypes}}" 
              wx:key="id"
              bindtap="onWorkTypeChange"
              data-id="{{item.id}}"
            >
              {{item.name}}
            </view>
          </view>
          
          <view class="available-works-grid">
            <view 
              class="available-work-item {{selectedWorks.indexOf(item._id) > -1 ? 'selected' : ''}}" 
              wx:for="{{availableWorks}}" 
              wx:key="_id"
              bindtap="onWorkSelect"
              data-id="{{item._id}}"
            >
              <image class="work-thumb" src="{{item.coverImage}}" mode="aspectFill"></image>
              <view class="work-checkbox"></view>
              <text class="work-name">{{item.title}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
      
      <view class="modal-footer">
        <button class="btn-cancel" bindtap="closeWorksModal">关闭</button>
        <button class="btn-confirm" bindtap="addSelectedWorks">添加选中 ({{selectedWorks.length}})</button>
      </view>
    </view>
  </view>
</view>
