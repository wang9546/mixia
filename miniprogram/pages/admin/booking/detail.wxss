.page-container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 140rpx;
}

.status-section {
  padding: 30rpx 0;
  text-align: center;
}

.status-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
}

.status-badge.status-pending {
  background: #fff3e0;
}

.status-badge.status-confirmed {
  background: #e3f2fd;
}

.status-badge.status-completed {
  background: #e8f5e9;
}

.status-badge.status-cancelled {
  background: #ffebee;
}

.status-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.status-pending .status-icon { color: #ff9800; }
.status-confirmed .status-icon { color: #2196f3; }
.status-completed .status-icon { color: #4caf50; }
.status-cancelled .status-icon { color: #f44336; }

.status-pending .status-text { color: #ff9800; }
.status-confirmed .status-text { color: #2196f3; }
.status-completed .status-text { color: #4caf50; }
.status-cancelled .status-text { color: #f44336; }

.status-text {
  font-size: 32rpx;
  font-weight: 500;
}

.info-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.card-header {
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.card-tip {
  font-size: 24rpx;
  color: #999;
}

.card-body {
  padding: 24rpx;
}

.info-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #999;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.info-value.primary {
  color: #C9A96E;
}

.info-action {
  font-size: 24rpx;
  color: #C9A96E;
  padding: 8rpx 20rpx;
  background: rgba(201, 169, 110, 0.1);
  border-radius: 4rpx;
}

.service-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}

.service-item:last-child {
  border-bottom: none;
}

.service-label {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.car-list {
  margin-bottom: 16rpx;
}

.car-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
  gap: 16rpx;
}

.car-row:last-child {
  border-bottom: none;
}

.car-info {
  flex: 1;
  min-width: 0;
}

.car-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 4rpx;
}

.car-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.car-quantity {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.quantity-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 32rpx;
  color: #666;
}

.quantity-input {
  width: 80rpx;
  height: 48rpx;
  text-align: center;
  font-size: 28rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
}

.car-remark {
  width: 120rpx;
  height: 48rpx;
  font-size: 24rpx;
  padding: 0 16rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
}

.remove-btn {
  font-size: 24rpx;
  color: #f44336;
  padding: 8rpx 16rpx;
}

.staff-list {
  margin-bottom: 16rpx;
}

.staff-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}

.staff-row:last-child {
  border-bottom: none;
}

.staff-info {
  flex: 1;
}

.staff-name {
  font-size: 28rpx;
  color: #333;
  margin-right: 16rpx;
}

.staff-type {
  font-size: 24rpx;
  color: #999;
}

.add-btn {
  width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #C9A96E;
  background: rgba(201, 169, 110, 0.1);
  border: none;
  border-radius: 8rpx;
}

.remark-input {
  width: 100%;
  height: 200rpx;
  font-size: 28rpx;
  color: #333;
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.time-info {
  padding: 24rpx;
  text-align: center;
}

.time-text {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  gap: 16rpx;
}

.bottom-bar button {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border-radius: 8rpx;
  border: none;
  padding: 0;
}

.btn-cancel {
  background: #f5f5f5;
  color: #666;
}

.btn-save {
  background: #fff;
  color: #C9A96E;
  border: 2rpx solid #C9A96E !important;
}

.btn-confirm {
  background: linear-gradient(135deg, #C9A96E 0%, #B8955F 100%);
  color: #fff;
}

.btn-poster {
  background: #fff;
  color: #C9A96E;
  border: 2rpx solid #C9A96E !important;
}

.btn-complete {
  background: linear-gradient(135deg, #4caf50 0%, #43a047 100%);
  color: #fff;
}

.btn-back {
  background: #f5f5f5;
  color: #666;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #C9A96E;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #999;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 90%;
  max-height: 80vh;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.picker-modal {
  max-height: 70vh;
}

.picker-list {
  max-height: 60vh;
  padding: 0 24rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-image {
  width: 120rpx;
  height: 80rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.picker-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.picker-info {
  flex: 1;
}

.picker-name {
  display: block;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.picker-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.picker-empty {
  padding: 60rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.poster-container {
  width: 90%;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.poster-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.poster-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.poster-canvas {
  width: 100%;
  height: 1000rpx;
}

.poster-footer {
  padding: 24rpx;
}

.btn-save-poster {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  background: linear-gradient(135deg, #C9A96E 0%, #B8955F 100%);
  border-radius: 8rpx;
  border: none;
}

.safe-area-bottom {
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}
