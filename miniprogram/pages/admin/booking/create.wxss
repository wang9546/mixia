.page-container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.page-header {
  text-align: center;
  padding: 40rpx 0;
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  letter-spacing: 4rpx;
}

.header-subtitle {
  display: block;
  font-size: 24rpx;
  color: #C9A96E;
  letter-spacing: 6rpx;
  margin-top: 12rpx;
}

.form-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 24rpx;
}

.section-icon {
  font-size: 28rpx;
  color: #C9A96E;
  margin-right: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.form-label.required::before {
  content: '*';
  color: #f44336;
  margin-right: 8rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  background: #f8f8f8;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
}

.picker-value {
  font-size: 28rpx;
  color: #333;
}

.form-picker.placeholder .picker-value {
  color: #999;
}

.picker-arrow {
  font-size: 28rpx;
  color: #C9A96E;
}

.form-textarea {
  width: 100%;
  height: 200rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333;
  background: #f8f8f8;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.input-placeholder {
  color: #999;
}

.textarea-item {
  margin-bottom: 0;
}

.submit-section {
  padding: 40rpx 20rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #fff;
  background: linear-gradient(135deg, #C9A96E 0%, #B8955F 100%);
  border-radius: 48rpx;
  border: none;
}

.submit-btn.disabled {
  opacity: 0.6;
}
