<view class="page-container">
  <view class="page-header">
    <text class="header-title">创建预约</text>
    <text class="header-subtitle">CREATE BOOKING</text>
  </view>

  <view class="form-section">
    <view class="section-header">
      <text class="section-icon">◈</text>
      <text class="section-title">联系信息</text>
    </view>
    
    <view class="form-item">
      <view class="form-label required">预约日期</view>
      <picker 
        mode="date" 
        start="{{minDate}}"
        value="{{formData.bookingDate}}"
        bindchange="onDateChange"
      >
        <view class="form-picker {{formData.bookingDate ? '' : 'placeholder'}}">
          <text class="picker-value">{{formData.bookingDate || '请选择预约日期'}}</text>
          <text class="picker-arrow">→</text>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <view class="form-label required">新郎姓名</view>
      <input 
        class="form-input" 
        placeholder="请输入新郎姓名"
        placeholder-class="input-placeholder"
        value="{{formData.groomName}}"
        bindinput="onInputChange"
        data-field="groomName"
      />
    </view>

    <view class="form-item">
      <view class="form-label required">新娘姓名</view>
      <input 
        class="form-input" 
        placeholder="请输入新娘姓名"
        placeholder-class="input-placeholder"
        value="{{formData.brideName}}"
        bindinput="onInputChange"
        data-field="brideName"
      />
    </view>

    <view class="form-item">
      <view class="form-label required">联系电话</view>
      <input 
        class="form-input" 
        type="number"
        placeholder="请输入联系电话"
        placeholder-class="input-placeholder"
        maxlength="11"
        value="{{formData.phone}}"
        bindinput="onInputChange"
        data-field="phone"
      />
    </view>

    <view class="form-item">
      <view class="form-label">微信号</view>
      <input 
        class="form-input" 
        placeholder="请输入微信号（选填）"
        placeholder-class="input-placeholder"
        value="{{formData.wechat}}"
        bindinput="onInputChange"
        data-field="wechat"
      />
    </view>

    <view class="form-item textarea-item">
      <view class="form-label">备注信息</view>
      <textarea 
        class="form-textarea" 
        placeholder="请输入备注信息..."
        placeholder-class="input-placeholder"
        maxlength="200"
        value="{{formData.remark}}"
        bindinput="onInputChange"
        data-field="remark"
      />
    </view>
  </view>

  <view class="submit-section">
    <button class="submit-btn {{submitting ? 'disabled' : ''}}" bindtap="onSubmit" disabled="{{submitting}}">
      <text class="btn-text">{{submitting ? '提交中...' : '创建预约'}}</text>
    </button>
  </view>
</view>
