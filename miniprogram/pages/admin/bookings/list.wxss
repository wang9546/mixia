.page-container {
  min-height: 100vh;
  background-color: #F5F6F8;
}

.stats-header {
  display: flex;
  padding: 24rpx;
  gap: 16rpx;
  background-color: #FFFFFF;
  margin-bottom: 16rpx;
}

.stat-card {
  flex: 1;
  padding: 32rpx;
  border-radius: 16rpx;
  text-align: center;
}

.stat-card.pending {
  background: linear-gradient(135deg, rgba(250, 173, 20, 0.15) 0%, rgba(250, 173, 20, 0.05) 100%);
}

.stat-card.confirmed {
  background: linear-gradient(135deg, rgba(82, 196, 26, 0.15) 0%, rgba(82, 196, 26, 0.05) 100%);
}

.stat-value {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.stat-card.pending .stat-value {
  color: #FAAD14;
}

.stat-card.confirmed .stat-value {
  color: #52C41A;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
}

.filter-bar {
  background-color: #FFFFFF;
  padding: 16rpx 0;
  margin-bottom: 16rpx;
}

.filter-scroll {
  white-space: nowrap;
}

.filter-list {
  display: inline-flex;
  padding: 0 24rpx;
  gap: 16rpx;
}

.filter-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  color: #666666;
  background-color: #F5F6F8;
  border-radius: 32rpx;
}

.filter-item.active {
  background: linear-gradient(135deg, #C9A96E 0%, #A68B4B 100%);
  color: #FFFFFF;
  font-weight: 500;
}

.list-container {
  padding: 0 24rpx;
}

.booking-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.booking-item {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
}

.booking-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.booking-no {
  font-size: 26rpx;
  color: #999999;
}

.booking-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.status-pending {
  background-color: rgba(250, 173, 20, 0.15);
  color: #FAAD14;
}

.status-confirmed {
  background-color: rgba(82, 196, 26, 0.15);
  color: #52C41A;
}

.status-completed {
  background-color: rgba(153, 153, 153, 0.15);
  color: #999999;
}

.status-cancelled {
  background-color: rgba(255, 77, 79, 0.15);
  color: #FF4D4F;
}

.booking-body {
  padding: 20rpx 24rpx;
}

.info-row {
  display: flex;
  margin-bottom: 12rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  font-size: 26rpx;
  color: #999999;
  width: 160rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 26rpx;
  color: #333333;
  flex: 1;
}

.booking-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #F5F5F5;
  background-color: #FAFAFA;
}

.booking-time {
  font-size: 24rpx;
  color: #999999;
}

.booking-actions {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: #C9A96E;
  background-color: transparent;
  border: 1rpx solid #C9A96E;
  border-radius: 24rpx;
  line-height: 1;
}

.action-btn.reject {
  color: #FF4D4F;
  border-color: #FF4D4F;
}

.action-btn::after {
  border: none;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

.loading-more, .loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  gap: 16rpx;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(201, 169, 110, 0.2);
  border-top-color: #C9A96E;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  color: #999999;
  font-size: 26rpx;
}

.no-more {
  text-align: center;
  padding: 40rpx 0;
}

.no-more-text {
  font-size: 24rpx;
  color: #999999;
}
