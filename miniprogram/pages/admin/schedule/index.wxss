.page-container {
  min-height: 100vh;
  background-color: #F5F6F8;
}

.date-header {
  background-color: #FFFFFF;
  padding: 24rpx 32rpx;
}

.date-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #F5F6F8;
  border-radius: 50%;
  font-size: 28rpx;
  color: #666666;
}

.nav-btn:active {
  background-color: #E8E9EB;
}

.date-display {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.date-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.date-week {
  font-size: 24rpx;
  color: #999999;
  margin-top: 4rpx;
}

.type-filter {
  background-color: #FFFFFF;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.type-scroll {
  white-space: nowrap;
}

.type-list {
  display: inline-flex;
  padding: 0 32rpx;
  gap: 16rpx;
}

.type-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  color: #666666;
  background-color: #F5F6F8;
  border-radius: 32rpx;
}

.type-item.active {
  background: linear-gradient(135deg, #C9A96E 0%, #A68B4B 100%);
  color: #FFFFFF;
  font-weight: 500;
}

.action-bar {
  padding: 24rpx 32rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
}

.add-task-btn {
  width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #C9A96E 0%, #A68B4B 100%);
  border-radius: 12rpx;
  border: none;
  color: #FFFFFF;
  font-size: 28rpx;
  gap: 8rpx;
}

.btn-icon {
  font-size: 32rpx;
  font-weight: 600;
}

.gantt-container {
  background-color: #FFFFFF;
  margin-top: 16rpx;
}

.gantt-wrapper {
  display: flex;
  flex-direction: column;
  width: 100%;
}

.gantt-scroll-x {
  width: 100%;
}

.gantt-content {
  min-width: 100%;
  display: inline-block;
}

.time-axis {
  display: flex;
  background-color: #FAFAFA;
  border-bottom: 2rpx solid #E8E9EB;
  position: sticky;
  top: 0;
  z-index: 10;
}

.axis-label {
  width: 200rpx;
  min-width: 200rpx;
  padding: 20rpx 16rpx;
  font-size: 26rpx;
  color: #666666;
  font-weight: 500;
  border-right: 1rpx solid #E8E9EB;
  position: sticky;
  left: 0;
  background-color: #FAFAFA;
  z-index: 15;
}

.axis-hours {
  display: flex;
  flex: 1;
}

.hour-label {
  width: 60rpx;
  min-width: 60rpx;
  padding: 20rpx 4rpx;
  text-align: center;
  font-size: 20rpx;
  color: #999999;
  border-right: 1rpx solid #F0F0F0;
}

.gantt-scroll-y {
  max-height: calc(100vh - 400rpx);
}

.gantt-body {
  display: flex;
  flex-direction: column;
}

.staff-row {
  display: flex;
  border-bottom: 1rpx solid #F0F0F0;
  min-height: 120rpx;
}

.staff-info {
  width: 200rpx;
  min-width: 200rpx;
  padding: 16rpx;
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-right: 1rpx solid #E8E9EB;
}

.staff-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  background-color: #F5F5F5;
}

.staff-detail {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.staff-name {
  font-size: 26rpx;
  color: #1A1A1A;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.staff-type {
  font-size: 22rpx;
  color: #999999;
}

.gantt-chart {
  flex: 1;
  position: relative;
  background-color: #FAFAFA;
  min-height: 120rpx;
}

.time-grid {
  display: flex;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
}

.grid-line {
  width: 60rpx;
  min-width: 60rpx;
  border-right: 1rpx solid #F0F0F0;
}

.task-blocks {
  position: relative;
  width: 100%;
  padding: 16rpx 0;
  min-height: 120rpx;
}

.task-block {
  position: absolute;
  height: 72rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  cursor: pointer;
  transition: all 0.3s ease;
}

.task-block:active {
  transform: scale(0.98);
}

.task-block.booked {
  background: linear-gradient(135deg, rgba(255, 77, 79, 0.9) 0%, rgba(255, 77, 79, 0.7) 100%);
  border: 2rpx solid rgba(255, 77, 79, 0.3);
}

.task-block.unavailable {
  background: linear-gradient(135deg, rgba(153, 153, 153, 0.9) 0%, rgba(153, 153, 153, 0.7) 100%);
  border: 2rpx solid rgba(153, 153, 153, 0.3);
}

.task-title {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  background-color: #FFFFFF;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(201, 169, 110, 0.2);
  border-top-color: #C9A96E;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  color: #999999;
  font-size: 28rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 640rpx;
  max-height: 80vh;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.modal-title {
  font-size: 32rpx;
  color: #1A1A1A;
  font-weight: 600;
}

.modal-close {
  font-size: 48rpx;
  color: #999999;
  line-height: 1;
}

.modal-body {
  padding: 32rpx;
  overflow-y: auto;
  flex: 1;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #1A1A1A;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-input,
.form-textarea,
.form-picker {
  width: 100%;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  background-color: #F5F6F8;
  border-radius: 12rpx;
  border: none;
  box-sizing: border-box;
}

.form-textarea {
  min-height: 160rpx;
}

.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
}

.picker-arrow {
  font-size: 20rpx;
  color: #999999;
}

.radio-group {
  display: flex;
  gap: 32rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #666666;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #F0F0F0;
}

.btn-delete,
.btn-cancel,
.btn-confirm {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
}

.btn-delete {
  background-color: #FF4D4F;
  color: #FFFFFF;
}

.btn-cancel {
  background-color: #F5F6F8;
  color: #666666;
}

.btn-confirm {
  background: linear-gradient(135deg, #C9A96E 0%, #A68B4B 100%);
  color: #FFFFFF;
}
