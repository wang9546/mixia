<view class="page-container">
  <view class="date-header">
    <view class="date-nav">
      <view class="nav-btn" bindtap="onPrevDay">←</view>
      <picker mode="date" value="{{currentDate}}" bindchange="onDateChange">
        <view class="date-display">
          <text class="date-text">{{currentDate}}</text>
          <text class="date-week">{{getDisplayDate()}}</text>
        </view>
      </picker>
      <view class="nav-btn" bindtap="onNextDay">→</view>
    </view>
  </view>

  <view class="type-filter">
    <scroll-view class="type-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="type-list">
        <view 
          class="type-item {{currentType === item.id ? 'active' : ''}}" 
          wx:for="{{staffTypes}}" 
          wx:key="id"
          bindtap="onTypeChange"
          data-id="{{item.id}}"
        >
          {{item.name}}
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="action-bar">
    <button class="add-task-btn" bindtap="onAddTask">
      <text class="btn-icon">+</text>
      <text>添加任务</text>
    </button>
  </view>

  <view class="gantt-container" wx:if="{{!loading && scheduleData.length > 0}}">
    <view class="gantt-wrapper">
      <scroll-view scroll-x="{{true}}" class="gantt-scroll-x" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="gantt-content">
          <view class="time-axis">
            <view class="axis-label">人员</view>
            <view class="axis-hours">
              <view class="hour-label" wx:for="{{hours}}" wx:key="value">{{item.label}}</view>
            </view>
          </view>

          <scroll-view scroll-y="{{true}}" class="gantt-scroll-y">
            <view class="gantt-body">
              <view class="staff-row" wx:for="{{scheduleData}}" wx:key="_id">
                <view class="staff-info" style="height: {{item.taskRows * 88 + 32}}rpx;">
                  <image class="staff-avatar" src="{{item.avatarUrl || item.avatar || '/images/icons/avatar.png'}}" mode="aspectFill"></image>
                  <view class="staff-detail">
                    <text class="staff-name">{{item.name}}</text>
                    <text class="staff-type">{{getTypeName(item.type)}}</text>
                  </view>
                </view>
                
                <view class="gantt-chart" style="height: {{item.taskRows * 88 + 32}}rpx;">
                  <view class="time-grid">
                    <view class="grid-line" wx:for="{{hours}}" wx:key="value"></view>
                  </view>
                  
                  <view class="task-blocks">
                    <view 
                      class="task-block {{task.status}}" 
                      wx:for="{{item.tasks}}" 
                      wx:for-item="task"
                      wx:key="id"
                      style="left: {{(task.startHour - 6) * 60}}rpx; width: {{(task.endHour - task.startHour) * 60}}rpx; top: {{task.row * 88 + 16}}rpx;"
                      bindtap="onTaskTap"
                      data-task="{{task}}"
                      data-staff="{{item}}"
                    >
                      <text class="task-title">{{task.title}}</text>
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </scroll-view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{!loading && scheduleData.length === 0}}">
    <text class="empty-icon">📅</text>
    <text class="empty-text">暂无人员数据</text>
  </view>

  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 添加/编辑任务弹窗 -->
  <view class="modal-mask" wx:if="{{showTaskModal}}" catchtap="closeTaskModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">{{isEdit ? '编辑任务' : '添加任务'}}</text>
        <text class="modal-close" bindtap="closeTaskModal">×</text>
      </view>
      
      <view class="modal-body">
        <view class="form-item">
          <text class="form-label">服务人员</text>
          <picker 
            mode="selector" 
            range="{{scheduleData}}" 
            range-key="name"
            value="{{selectedStaffIndex}}"
            bindchange="onStaffChange"
          >
            <view class="form-picker">
              <text>{{scheduleData[selectedStaffIndex].name || '请选择'}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>

        <view class="form-item">
          <text class="form-label">任务项</text>
          <textarea 
            class="form-textarea" 
            placeholder="请输入任务项" 
            value="{{taskTitle}}"
            bindinput="onTaskTitleInput"
            maxlength="100"
          />
        </view>

        <view class="form-item">
          <text class="form-label">备注</text>
          <textarea 
            class="form-textarea" 
            placeholder="请输入备注信息" 
            value="{{taskRemark}}"
            bindinput="onTaskRemarkInput"
            maxlength="200"
          />
        </view>

        <view class="form-item">
          <text class="form-label">开始时间</text>
          <picker 
            mode="selector" 
            range="{{hours}}" 
            range-key="label"
            value="{{startHourIndex}}"
            bindchange="onStartHourChange"
          >
            <view class="form-picker">
              <text>{{hours[startHourIndex].label}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>

        <view class="form-item">
          <text class="form-label">结束时间</text>
          <picker 
            mode="selector" 
            range="{{hours}}" 
            range-key="label"
            value="{{endHourIndex}}"
            bindchange="onEndHourChange"
          >
            <view class="form-picker">
              <text>{{hours[endHourIndex].label}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>

        <view class="form-item">
          <text class="form-label">状态</text>
          <radio-group class="radio-group" bindchange="onTaskStatusChange">
            <label class="radio-item">
              <radio value="booked" checked="{{taskStatus === 'booked'}}" />
              <text>已预约</text>
            </label>
            <label class="radio-item">
              <radio value="unavailable" checked="{{taskStatus === 'unavailable'}}" />
              <text>不可用</text>
            </label>
          </radio-group>
        </view>
      </view>
      
      <view class="modal-footer">
        <button class="btn-delete" wx:if="{{isEdit}}" bindtap="onDeleteTask">删除</button>
        <button class="btn-cancel" bindtap="closeTaskModal">取消</button>
        <button class="btn-confirm" bindtap="onSaveTask">确定</button>
      </view>
    </view>
  </view>
</view>
