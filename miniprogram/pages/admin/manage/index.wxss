.manage-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FDF9F6 0%, #F8F4F0 50%, #F5EFE8 100%);
  padding-bottom: 60rpx;
}

.action-bar {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  gap: 20rpx;
  border-bottom: 1rpx solid rgba(201, 168, 124, 0.1);
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, rgba(232, 196, 184, 0.1) 0%, rgba(212, 165, 165, 0.1) 100%);
  border-radius: 48rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(201, 168, 124, 0.15);
}

.search-icon-wrap {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-icon {
  font-size: 16rpx;
  color: var(--price-color);
}

.search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  color: var(--primary-color);
  background: transparent;
}

.add-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #2D2A26 0%, #3D3A36 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 48rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  font-weight: 500;
  margin: 0;
  line-height: 1.5;
  box-shadow: 0 8rpx 24rpx rgba(45, 42, 38, 0.15);
  border: 1rpx solid rgba(201, 168, 124, 0.2);
}

.add-btn::after {
  border: none;
}

.add-btn.large {
  padding: 20rpx 48rpx;
  font-size: 30rpx;
}

.add-icon {
  font-size: 24rpx;
  color: var(--price-color);
}

.add-text {
  letter-spacing: 4rpx;
}

.tag-scroll {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  padding: 20rpx 0;
  white-space: nowrap;
  border-bottom: 1rpx solid rgba(201, 168, 124, 0.1);
}

.tag-list {
  display: inline-flex;
  padding: 0 24rpx;
  gap: 16rpx;
}

.tag-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 32rpx;
  background: linear-gradient(135deg, rgba(232, 196, 184, 0.1) 0%, rgba(212, 165, 165, 0.1) 100%);
  border-radius: 48rpx;
  font-size: 26rpx;
  color: var(--text-color-light);
  flex-shrink: 0;
  border: 1rpx solid rgba(201, 168, 124, 0.15);
  transition: all 0.3s ease;
}

.tag-item.active {
  background: linear-gradient(135deg, rgba(201, 168, 124, 0.15) 0%, rgba(184, 149, 110, 0.15) 100%);
  color: var(--price-color);
  border-color: rgba(201, 168, 124, 0.3);
}

.tag-text {
  letter-spacing: 2rpx;
  font-weight: 500;
}

.tag-indicator {
  width: 32rpx;
  height: 3rpx;
  background: var(--gradient-gold);
  margin-top: 8rpx;
  border-radius: 2rpx;
}

.data-list {
  padding: 24rpx;
}

.data-item {
  display: flex;
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FDF9F6 100%);
}

.item-cover-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background: linear-gradient(135deg, #F5EFE8 0%, #E8E0D8 100%);
  position: relative;
  overflow: hidden;
}

.item-cover {
  width: 100%;
  height: 100%;
}

.cover-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, transparent 70%, rgba(45, 42, 38, 0.08) 100%);
}

.item-info {
  flex: 1;
  padding: 0 20rpx;
  min-width: 0;
}

.item-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--primary-color);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 2rpx;
}

.item-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-color-light);
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.item-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 14rpx;
  background: linear-gradient(135deg, rgba(232, 196, 184, 0.15) 0%, rgba(212, 165, 165, 0.15) 100%);
  border-radius: 16rpx;
  font-size: 22rpx;
  color: var(--accent-rose);
  border: 1rpx solid rgba(212, 165, 165, 0.2);
}

.tag-star {
  font-size: 14rpx;
  color: var(--price-color);
}

.tag-label {
  letter-spacing: 1rpx;
}

.item-actions {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-end;
  flex-shrink: 0;
}

.status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  border: 1rpx solid;
}

.status.active {
  background: linear-gradient(135deg, rgba(201, 168, 124, 0.15) 0%, rgba(184, 149, 110, 0.15) 100%);
  color: var(--price-color);
  border-color: rgba(201, 168, 124, 0.3);
}

.status.inactive {
  background: linear-gradient(135deg, rgba(168, 165, 160, 0.15) 0%, rgba(160, 158, 155, 0.15) 100%);
  color: var(--text-color-light);
  border-color: rgba(168, 165, 160, 0.3);
}

.status-icon {
  font-size: 16rpx;
}

.status-text {
  letter-spacing: 2rpx;
}

.action-btns {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  border: 1rpx solid;
}

.action-btn.edit {
  color: var(--price-color);
  background: linear-gradient(135deg, rgba(201, 168, 124, 0.1) 0%, rgba(184, 149, 110, 0.1) 100%);
  border-color: rgba(201, 168, 124, 0.2);
}

.action-btn.delete {
  color: #D4A5A5;
  background: linear-gradient(135deg, rgba(212, 165, 165, 0.1) 0%, rgba(180, 140, 140, 0.1) 100%);
  border-color: rgba(212, 165, 165, 0.2);
}

.btn-icon {
  font-size: 18rpx;
}

.btn-label {
  letter-spacing: 2rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 24rpx;
}

.empty-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.empty-ring-outer {
  width: 80rpx;
  height: 80rpx;
  border: 2rpx solid rgba(201, 168, 124, 0.2);
  border-radius: 50%;
}

.empty-ring-inner {
  position: absolute;
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid rgba(201, 168, 124, 0.3);
  border-radius: 50%;
}

.empty-icon {
  position: absolute;
  font-size: 24rpx;
  color: var(--price-color);
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-color-light);
  letter-spacing: 4rpx;
}

.load-more {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
  gap: 16rpx;
}

.load-decoration {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.load-line {
  width: 48rpx;
  height: 2rpx;
  background: linear-gradient(90deg, rgba(201, 168, 124, 0.3) 0%, rgba(201, 168, 124, 0.6) 100%);
}

.load-dot {
  width: 8rpx;
  height: 8rpx;
  background: var(--price-color);
  border-radius: 50%;
}

.load-text {
  font-size: 28rpx;
  color: var(--price-color);
  letter-spacing: 4rpx;
}