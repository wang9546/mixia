<view class="page-container">
  <view class="filter-header">
    <view class="header-title">婚纱摄影</view>
    <view class="sort-tabs">
      <view class="sort-tab {{sortType === 'new' ? 'active' : ''}}" bindtap="onSortChange" data-type="new">最新</view>
      <view class="sort-divider"></view>
      <view class="sort-tab {{sortType === 'hot' ? 'active' : ''}}" bindtap="onSortChange" data-type="hot">最热</view>
    </view>
  </view>

  <view class="filter-section">
    <view class="filter-row">
      <view class="filter-label">标签</view>
      <scroll-view class="filter-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="filter-list">
          <view 
            class="filter-item {{activeTag === item._id ? 'active' : ''}}" 
            wx:for="{{tags}}" 
            wx:key="_id"
            bindtap="onTagChange"
            data-id="{{item._id}}"
          >
            {{item.name}}
          </view>
        </view>
      </scroll-view>
    </view>
    <view class="filter-row">
      <view class="filter-label">城市</view>
      <view class="city-picker-wrap">
        <picker mode="region" bindchange="onCityChange" level="city">
          <view class="city-picker">
            <text class="city-text">{{activeCity || '全部城市'}}</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
        <view class="city-clear" wx:if="{{activeCity}}" bindtap="onClearCity">×</view>
      </view>
    </view>
  </view>

  <view class="list-section">
    <view class="list-count" wx:if="{{total > 0}}">共 {{total}} 个作品</view>
    
    <view class="list-grid" wx:if="{{list.length > 0}}">
      <view class="list-item" wx:for="{{list}}" wx:key="_id" bindtap="onItemTap" data-id="{{item._id}}">
        <view class="item-cover-wrap">
          <image class="item-cover" src="{{item.coverImage}}" mode="aspectFill"></image>
          <view class="item-cover-overlay"></view>
        </view>
        <view class="item-info">
          <view class="item-title">{{item.title}}</view>
          <view class="item-meta">
            <text class="item-tag" wx:if="{{item.tags && item.tags.length > 0}}">{{item.tags[0].name}}</text>
            <text class="item-city" wx:if="{{item.city}}">{{item.city}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{!loading && list.length === 0}}">
      <view class="empty-icon-wrap">
        <text class="empty-icon-text">📷</text>
      </view>
      <text class="empty-text">暂无相关作品</text>
      <text class="empty-hint">换个筛选条件试试吧</text>
    </view>

    <view class="loading-more" wx:if="{{loadingMore}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <view class="no-more" wx:if="{{noMore && list.length > 0}}">
      <view class="no-more-line"></view>
      <text class="no-more-text">已经到底了</text>
      <view class="no-more-line"></view>
    </view>
  </view>

  <float-service />
</view>
