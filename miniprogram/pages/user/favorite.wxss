.page-container {
  min-height: 100vh;
  background-color: #FAFAFA;
  padding-bottom: env(safe-area-inset-bottom);
}

.favorite-list {
  padding: 24rpx;
}

.favorite-item {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
}

.case-content {
  display: flex;
  padding: 24rpx;
  transition: all 0.3s ease;
}

.case-content:active {
  background-color: #FAFAFA;
}

.case-cover-wrap {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.case-cover {
  width: 100%;
  height: 100%;
  background-color: #f5f5f5;
}

.case-cover-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 40%;
  background: linear-gradient(to top, rgba(0,0,0,0.15) 0%, transparent 100%);
  pointer-events: none;
}

.case-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.case-title {
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.case-meta {
  display: flex;
  align-items: center;
}

.case-type {
  font-size: 22rpx;
  color: #C9A96E;
  background: linear-gradient(135deg, rgba(201, 169, 110, 0.15) 0%, rgba(201, 169, 110, 0.08) 100%);
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(201, 169, 110, 0.2);
}

.remove-btn {
  padding: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999999;
  border-top: 1rpx solid #F5F5F5;
  letter-spacing: 1rpx;
  transition: all 0.3s ease;
}

.remove-btn:active {
  background-color: #FAFAFA;
  color: #666666;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.empty-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(201, 169, 110, 0.15) 0%, rgba(201, 169, 110, 0.08) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-icon-text {
  font-size: 48rpx;
  color: #C9A96E;
}

.empty-text {
  color: #999999;
  font-size: 28rpx;
  letter-spacing: 1rpx;
}

.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  gap: 16rpx;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(201, 169, 110, 0.2);
  border-top-color: #C9A96E;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  color: #999999;
  font-size: 26rpx;
  letter-spacing: 1rpx;
}

.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 0;
  gap: 24rpx;
}

.no-more-line {
  width: 60rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent 0%, #EAEAEA 50%, transparent 100%);
}

.no-more-text {
  color: #999999;
  font-size: 24rpx;
  letter-spacing: 1rpx;
}
