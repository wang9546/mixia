<view class="page-container">
  <view class="favorite-list" wx:if="{{favorites.length > 0}}">
    <view class="favorite-item" wx:for="{{favorites}}" wx:key="_id">
      <view class="case-content" bindtap="onCaseTap" data-id="{{item._id}}">
        <view class="case-cover-wrap">
          <image class="case-cover" src="{{item.coverImage}}" mode="aspectFill"></image>
          <view class="case-cover-overlay"></view>
        </view>
        <view class="case-info">
          <view class="case-title">{{item.title}}</view>
          <view class="case-meta">
            <text class="case-type">{{item.serviceType === 'wedding_car' ? '婚车服务' : item.serviceType === 'dress' ? '婚纱礼服' : item.serviceType === 'photography' ? '婚礼摄影' : '一站式套餐'}}</text>
          </view>
        </view>
      </view>
      <view class="remove-btn" catchtap="onRemoveTap" data-id="{{item._id}}">取消收藏</view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{!loading && favorites.length === 0}}">
    <view class="empty-icon-wrap">
      <text class="empty-icon-text">♡</text>
    </view>
    <text class="empty-text">暂无收藏</text>
  </view>

  <view class="loading-more" wx:if="{{loadingMore}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <view class="no-more" wx:if="{{noMore && favorites.length > 0}}">
    <view class="no-more-line"></view>
    <text class="no-more-text">已经到底了</text>
    <view class="no-more-line"></view>
  </view>
</view>
