/* ── 个人页 · 极简雅白 ── */

.user-container {
  min-height:     100vh;
  background:     var(--paper);
  padding-bottom: 100rpx;
}

/* ─── 顶部区域（浅底色，非深色）─── */
.user-header {
  display:          flex;
  flex-direction:   column;
  align-items:      stretch;
  padding:          56rpx 40rpx 44rpx;
  position:         relative;
  overflow:         hidden;
  background:       var(--paper);
}

.header-bg { display: none; }

/* 顶部装饰线：不显示 */
.header-decoration { display: none; }

/* ─── 横向头像+信息行 ─── */
.user-profile-row {
  display:     flex;
  align-items: center;
  width:       100%;
}

/* ─── 头像 ─── */
.avatar-section {
  margin-bottom: 0;
  margin-right:  28rpx;
  flex-shrink:   0;
}

.avatar-frame {
  position:        relative;
  display:         flex;
  align-items:     center;
  justify-content: center;
}

.avatar-btn {
  width:         96rpx !important;
  height:        96rpx !important;
  border-radius: 50% !important;
  overflow:      hidden;
  padding:       0 !important;
  margin:        0 !important;
  background:    transparent !important;
  border:        none !important;
  position:      relative;
  z-index:       3;
}

.avatar-placeholder {
  width:         96rpx;
  height:        96rpx;
  border-radius: 50%;
  overflow:      hidden;
  position:      relative;
  z-index:       3;
  background:    #EEEBE6;
}

.avatar {
  width:         100% !important;
  height:        100% !important;
  display:       block !important;
  object-fit:    cover !important;
  border-radius: 50% !important;
}

/* 头像外圈：仅一根细线 */
.avatar-ring {
  position:      absolute;
  top:           -6rpx;
  left:          -6rpx;
  right:         -6rpx;
  bottom:        -6rpx;
  border:        1rpx solid var(--gold-line);
  border-radius: 50%;
  z-index:       2;
}

.avatar-glow { display: none; }

/* ─── 用户信息 ─── */
.user-info {
  display:        flex;
  flex-direction: column;
  align-items:    flex-start;
  flex:           1;
  min-height:     auto;
}

.nickname {
  font-size:      34rpx;
  font-weight:    400;
  color:          var(--ink);
  margin-bottom:  10rpx;
  letter-spacing: 5rpx;
}

.nickname-input {
  font-size:      34rpx;
  font-weight:    400;
  color:          var(--ink);
  width:          100%;
  height:         48rpx;
  min-height:     48rpx;
  padding:        0;
  background:     transparent;
  border:         none;
  text-align:     left;
  letter-spacing: 5rpx;
}

.user-badge {
  display:         flex;
  align-items:     center;
  gap:             6rpx;
  padding:         7rpx 20rpx;
  border-radius:   20rpx;
  border:          1rpx solid var(--rule);
  margin-top:      8rpx;
  background:      var(--paper);
}

.badge-icon {
  font-size: 11rpx;
  color:     var(--gold);
}

.badge-text {
  font-size:      19rpx;
  color:          var(--stone);
  letter-spacing: 2rpx;
}

.user-desc {
  font-size:      24rpx;
  color:          var(--dust);
  margin-bottom:  16rpx;
  letter-spacing: 2rpx;
}

.login-action {
  margin-top: 8rpx;
}

/* 登录按钮：深色底 */
.login-btn {
  display:         flex;
  align-items:     center;
  gap:             10rpx;
  padding:         16rpx 48rpx;
  background:      var(--ink);
  color:           #FFFFFF;
  border:          none !important;
  border-radius:   var(--border-radius-lg);
  font-size:       25rpx;
  font-weight:     400;
  margin:          0;
  line-height:     1.5;
  letter-spacing:  4rpx;
  text-indent:     4rpx;
}

.login-btn::after { border: none; }

.login-icon {
  font-size: 12rpx;
  color:     var(--gold);
}

.login-text {
  letter-spacing: 4rpx;
}

/* ─── 菜单列表 ─── */
.menu-list {
  margin:        24rpx var(--margin-page) 0;
  padding:       0 32rpx;
  background:    var(--white);
  border-radius: var(--border-radius-card);
  border:        1rpx solid var(--rule);
  box-shadow:    var(--shadow-card);
  position:      relative;
  overflow:      hidden;
}

.menu-list::before {
  content:    '';
  position:   absolute;
  top: 0; left: 0; right: 0;
  height:     1rpx;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
  opacity:    0.25;
}

.menu-item {
  display:     flex;
  align-items: center;
  padding:     32rpx 0;
  position:    relative;
}

.menu-icon-wrap {
  width:           44rpx;
  height:          44rpx;
  display:         flex;
  align-items:     center;
  justify-content: center;
  background:      var(--paper);
  border-radius:   50%;
  margin-right:    20rpx;
  border:          1rpx solid var(--rule);
  flex-shrink:     0;
}

.menu-icon {
  font-size: 20rpx;
  color:     var(--stone);
}

.menu-text {
  flex:           1;
  font-size:      27rpx;
  color:          var(--ink);
  letter-spacing: 2rpx;
  font-weight:    400;
}

.menu-arrow-wrap {
  width:           36rpx;
  height:          36rpx;
  display:         flex;
  align-items:     center;
  justify-content: center;
}

.menu-arrow {
  color:     var(--dust);
  font-size: 19rpx;
}

.menu-divider {
  height:     1rpx;
  background: var(--rule);
  margin:     0;
}

.share-btn {
  position: absolute;
  inset:    0;
  opacity:  0;
  z-index:  10;
}

/* ─── 数据面板（若有）─── */
.stats-panel {
  display:         flex;
  justify-content: space-between;
  align-items:     center;
  padding:         36rpx 16rpx;
  margin:          16rpx var(--margin-page) 0;
  background:      var(--white);
  border-radius:   var(--border-radius-card);
  border:          1rpx solid var(--rule);
  box-shadow:      var(--shadow-card);
  position:        relative;
  overflow:        hidden;
}

.stats-panel::before {
  content:    '';
  position:   absolute;
  top: 0; left: 0; right: 0;
  height:     1rpx;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
  opacity:    0.25;
}

.stats-decoration { display: none; }
.stats-line       { display: none; }

.stat-item {
  display:        flex;
  flex-direction: column;
  align-items:    center;
  gap:            6rpx;
  flex:           1;
}

.stat-icon-wrap {
  width:           32rpx;
  height:          32rpx;
  display:         flex;
  align-items:     center;
  justify-content: center;
  border-radius:   50%;
  background:      var(--paper);
  border:          1rpx solid var(--rule);
  margin-bottom:   3rpx;
}

.stat-icon-wrap.dress,
.stat-icon-wrap.decoration,
.stat-icon-wrap.car,
.stat-icon-wrap.vendor { background: var(--paper); }

.stat-icon {
  font-size: 13rpx;
  color:     var(--gold);
}

.stat-num {
  font-size:   34rpx;
  font-weight: 500;
  color:       var(--ink);
}

.stat-label {
  font-size:      19rpx;
  color:          var(--dust);
  letter-spacing: 2rpx;
}

.stat-divider {
  width:      1rpx;
  height:     44rpx;
  background: var(--rule);
}

/* ─── 页脚 ─── */
.footer-decoration {
  display:         flex;
  align-items:     center;
  justify-content: center;
  gap:             20rpx;
  padding:         56rpx 0;
}

.footer-line {
  width:      56rpx;
  height:     1rpx;
  background: linear-gradient(90deg, transparent, rgba(0, 0, 0, 0.10), transparent);
}

.footer-dot { display: none; }
