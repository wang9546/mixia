.page-container {
  min-height: 100vh;
  background-color: #FAFAFA;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

.user-header {
  position: relative;
  padding: 120rpx 60rpx 80rpx;
  background-color: #FFFFFF;
  margin-bottom: 2rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-btn {
  position: relative;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: normal;
  margin-bottom: 30rpx;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.05);
  transition: all 0.4s ease;
}

.avatar:active {
  transform: scale(0.95);
}

.avatar-edit {
  position: absolute;
  bottom: 0;
  right: 0;
  background-color: #111111;
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  letter-spacing: 2rpx;
  font-weight: 300;
}

.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #F0F0F0;
  margin-bottom: 30rpx;
}

.user-detail {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nickname-input {
  font-family: 'Times New Roman', Times, serif;
  font-size: 40rpx;
  font-weight: 400;
  color: #111111;
  background: transparent;
  padding: 0;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
  text-align: center;
}

.nickname-placeholder {
  color: #999999;
}

.nickname-loading,
.nickname-error {
  font-size: 32rpx;
  color: #111111;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.user-id {
  font-size: 22rpx;
  color: #999999;
  letter-spacing: 1rpx;
  font-weight: 300;
}

.retry-btn {
  font-size: 24rpx;
  color: #B89C6D;
  padding: 12rpx 30rpx;
  border: 1rpx solid rgba(184, 156, 109, 0.5);
  border-radius: 30rpx;
  margin-top: 20rpx;
  letter-spacing: 2rpx;
}

.admin-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 40rpx 40rpx;
  padding: 40rpx 40rpx;
  background-color: #111111;
  transition: all 0.4s ease;
}

.admin-entry:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.admin-info {
  display: flex;
  flex-direction: column;
}

.admin-en {
  font-family: 'Times New Roman', Times, serif;
  font-size: 20rpx;
  color: #B89C6D;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}

.admin-title {
  font-size: 28rpx;
  font-weight: 400;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.admin-arrow {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 300;
}

.menu-section {
  background-color: #FFFFFF;
  margin-top: 20rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 40rpx 60rpx;
  border-bottom: 1rpx solid rgba(0,0,0,0.03);
  transition: background-color 0.3s ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background-color: #FAFAFA;
}

.menu-icon-wrap {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
}

.menu-icon {
  width: 100%;
  height: 100%;
  opacity: 0.8;
}

.menu-content {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.menu-title {
  font-size: 28rpx;
  color: #111111;
  font-weight: 400;
  letter-spacing: 2rpx;
}

.menu-arrow {
  font-size: 28rpx;
  color: #DDDDDD;
  font-weight: 300;
}

.brand-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 100rpx;
}

.footer-brand {
  font-family: 'Times New Roman', Times, serif;
  font-size: 36rpx;
  color: #B89C6D;
  letter-spacing: 12rpx;
  margin-left: 12rpx;
  margin-bottom: 20rpx;
}

.footer-name {
  font-size: 24rpx;
  color: #111111;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
  font-weight: 400;
}

.footer-slogan {
  font-size: 20rpx;
  color: #999999;
  letter-spacing: 4rpx;
  font-weight: 300;
}
