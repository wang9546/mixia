<view class="page-container">
  <view class="user-header">
    <view class="header-bg"></view>
    <view class="user-info" wx:if="{{userInfo && !loading}}">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="avatar" src="{{userInfo.avatarUrl || '/images/icons/avatar.png'}}" mode="aspectFill"></image>
        <view class="avatar-edit">编辑</view>
      </button>
      <view class="user-detail">
        <input 
          class="nickname-input" 
          type="nickname" 
          placeholder="点击设置昵称" 
          placeholder-class="nickname-placeholder"
          value="{{userInfo.nickName}}"
          bindblur="onNicknameInput"
          bindconfirm="onNicknameInput"
        />
        <view class="user-id">ID: {{userInfo._id}}</view>
      </view>
    </view>
    <view class="user-info" wx:elif="{{loading}}">
      <view class="avatar-placeholder"></view>
      <view class="user-detail">
        <view class="nickname-loading">加载中...</view>
      </view>
    </view>
    <view class="user-info error-state" wx:else>
      <view class="avatar-placeholder"></view>
      <view class="user-detail">
        <view class="nickname-error">加载失败</view>
        <view class="retry-btn" bindtap="onRetry">点击重试</view>
      </view>
    </view>
  </view>

  <view class="admin-entry" wx:if="{{isAdmin && !loading}}" bindtap="onAdminTap">
    <view class="admin-info">
      <text class="admin-en">ADMINISTRATION</text>
      <text class="admin-title">管理后台</text>
    </view>
    <text class="admin-arrow">→</text>
  </view>

  <view class="menu-section" wx:if="{{!error}}">
    <view 
      class="menu-item" 
      wx:for="{{menuList}}" 
      wx:key="id"
      bindtap="onMenuTap"
      data-url="{{item.url}}"
    >
      <view class="menu-icon-wrap">
        <image class="menu-icon" src="{{item.icon}}" mode="aspectFit"></image>
      </view>
      <view class="menu-content">
        <text class="menu-title">{{item.title}}</text>
        <text class="menu-arrow">→</text>
      </view>
    </view>
  </view>

  <view class="brand-footer">
    <text class="footer-brand">MISCHA</text>
    <text class="footer-name">米夏婚礼</text>
    <text class="footer-slogan">让每一场相遇，都被温柔以待</text>
  </view>
</view>
