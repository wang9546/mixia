<view class="container user-container">
  <view class="user-header">
    <view class="header-bg"></view>
    <view class="header-decoration">
      <view class="decor-line-left"></view>
      <view class="decor-dot"></view>
      <view class="decor-line-right"></view>
    </view>
    <view class="user-profile-row">
      <view class="avatar-section">
        <view class="avatar-frame">
          <button wx:if="{{hasUserInfo}}" class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
            <image class="avatar" src="{{userInfo.avatarUrl || '/images/tabbar/user.png'}}" mode="aspectFill"></image>
          </button>
          <view wx:else class="avatar-placeholder">
            <image class="avatar" src="/images/tabbar/user.png" mode="aspectFill"></image>
          </view>
          <view class="avatar-ring"></view>
          <view class="avatar-glow"></view>
        </view>
      </view>
      <view class="user-info">
        <block wx:if="{{hasUserInfo}}">
          <input type="nickname"
                 class="nickname-input"
                 value="{{tempNickname}}"
                 bindinput="onNicknameInput"
                 bindblur="onNicknameBlur"
                 placeholder="点击设置昵称" />
          <view class="user-badge">
            <text class="badge-icon">✦</text>
            <text class="badge-text">欢迎回来</text>
          </view>
        </block>
        <block wx:else>
          <view class="nickname">未登录</view>
          <view class="user-desc">点击登录体验更多功能</view>
          <view class="login-action">
            <button class="login-btn" bindtap="onLoginTap">
              <text class="login-icon">✦</text>
              <text class="login-text">立即登录</text>
            </button>
          </view>
        </block>
      </view>
    </view>
    <view class="header-decoration bottom">
      <view class="decor-line-left"></view>
      <view class="decor-dot"></view>
      <view class="decor-line-right"></view>
    </view>
  </view>

  <view class="menu-list card">
    <view class="menu-item" wx:if="{{isAdmin}}" bindtap="goToAdmin">
      <view class="menu-icon-wrap">
        <text class="menu-icon">⚙</text>
      </view>
      <text class="menu-text">后台管理</text>
      <view class="menu-arrow-wrap">
        <text class="menu-arrow">→</text>
      </view>
    </view>
    <view class="menu-divider" wx:if="{{isAdmin}}"></view>
    <view class="menu-item" bindtap="goToContact">
      <view class="menu-icon-wrap">
        <text class="menu-icon">✆</text>
      </view>
      <text class="menu-text">联系客服</text>
      <view class="menu-arrow-wrap">
        <text class="menu-arrow">→</text>
      </view>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item">
      <button open-type="share" class="share-btn"></button>
      <view class="menu-icon-wrap">
        <text class="menu-icon">↗</text>
      </view>
      <text class="menu-text">推荐给好友</text>
      <view class="menu-arrow-wrap">
        <text class="menu-arrow">→</text>
      </view>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" bindtap="clearCache">
      <view class="menu-icon-wrap">
        <text class="menu-icon">🗑</text>
      </view>
      <text class="menu-text">清除缓存</text>
      <view class="menu-arrow-wrap">
        <text class="menu-arrow">→</text>
      </view>
    </view>
  </view>

  <view class="footer-decoration">
    <view class="footer-line"></view>
    <view class="footer-dot"></view>
    <view class="footer-line"></view>
  </view>
</view>