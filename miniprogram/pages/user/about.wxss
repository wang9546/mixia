.page-container {
  min-height: 100vh;
  background-color: #FAFAFA;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

.about-header {
  background-color: #FFFFFF;
  padding: 120rpx 40rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 2rpx;
}

.logo-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #FAFAFA;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.logo-text {
  font-family: 'Times New Roman', Times, serif;
  font-size: 32rpx;
  color: #B89C6D;
  letter-spacing: 8rpx;
  margin-left: 8rpx;
}

.name {
  font-size: 40rpx;
  font-weight: 400;
  color: #111111;
  letter-spacing: 4rpx;
  margin-bottom: 20rpx;
}

.slogan {
  font-size: 24rpx;
  color: #999999;
  letter-spacing: 2rpx;
  font-weight: 300;
}

.about-section {
  background-color: #FFFFFF;
  padding: 80rpx 40rpx;
  margin-bottom: 2rpx;
}

.section-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
  text-align: center;
}

.section-subtitle {
  font-family: 'Times New Roman', Times, serif;
  font-size: 20rpx;
  color: #B89C6D;
  letter-spacing: 6rpx;
  margin-bottom: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 400;
  color: #111111;
  letter-spacing: 4rpx;
}

.section-content {
  font-size: 26rpx;
  color: #666666;
  line-height: 2.2;
  letter-spacing: 2rpx;
  font-weight: 300;
  text-align: justify;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  padding-bottom: 40rpx;
  border-bottom: 1rpx solid rgba(0,0,0,0.03);
}

.feature-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.feature-icon {
  font-size: 24rpx;
  color: #B89C6D;
  margin-right: 24rpx;
  margin-top: 6rpx;
}

.feature-text {
  flex: 1;
  font-size: 26rpx;
  color: #444444;
  line-height: 1.8;
  letter-spacing: 2rpx;
  font-weight: 300;
}

.about-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.footer-brand {
  font-family: 'Times New Roman', Times, serif;
  font-size: 24rpx;
  color: #B89C6D;
  letter-spacing: 6rpx;
  margin-bottom: 16rpx;
}

.footer-copyright {
  font-size: 20rpx;
  color: #999999;
  letter-spacing: 2rpx;
  font-weight: 300;
}
