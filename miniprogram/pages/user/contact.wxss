.page-container {
  min-height: 100vh;
  background-color: #FAFAFA;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 加载状态 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(201, 169, 110, 0.2);
  border-top-color: #C9A96E;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  color: #999999;
  font-size: 28rpx;
  letter-spacing: 1rpx;
}

/* 门店图片 */
.store-images {
  width: 100%;
  height: 400rpx;
}

.image-swiper {
  width: 100%;
  height: 100%;
}

.store-image {
  width: 100%;
  height: 100%;
  background-color: #f5f5f5;
}

/* 门店头部 */
.store-header {
  background-color: #FFFFFF;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
}

.store-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #1A1A1A;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.store-desc {
  font-size: 26rpx;
  color: #666666;
  letter-spacing: 1rpx;
  line-height: 1.6;
}

/* 信息卡片 */
.info-card {
  background-color: #FFFFFF;
  margin: 0 24rpx 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
}

.info-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  transition: all 0.3s ease;
}

.info-item:active {
  background-color: #FAFAFA;
}

.info-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(201, 169, 110, 0.15) 0%, rgba(201, 169, 110, 0.08) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.info-icon-img {
  width: 32rpx;
  height: 32rpx;
}

.info-content {
  flex: 1;
}

.info-label {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
}

.info-value {
  font-size: 28rpx;
  color: #1A1A1A;
  letter-spacing: 1rpx;
}

.info-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.action-text {
  font-size: 24rpx;
  color: #C9A96E;
  letter-spacing: 1rpx;
}

.action-arrow {
  font-size: 24rpx;
  color: #C9A96E;
}

/* 联系方式区块 */
.contact-section {
  background-color: #FFFFFF;
  margin: 0 24rpx 24rpx;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
}

.section-header {
  display: flex;
  flex-direction: column;
  margin-bottom: 28rpx;
}

.section-subtitle {
  font-size: 20rpx;
  color: #C9A96E;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  letter-spacing: 2rpx;
}

/* 联系方式列表 */
.contact-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: linear-gradient(135deg, rgba(201, 169, 110, 0.05) 0%, rgba(201, 169, 110, 0.02) 100%);
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.contact-item:active {
  background: linear-gradient(135deg, rgba(201, 169, 110, 0.1) 0%, rgba(201, 169, 110, 0.05) 100%);
}

.contact-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.phone-icon {
  background: linear-gradient(135deg, rgba(201, 169, 110, 0.15) 0%, rgba(201, 169, 110, 0.08) 100%);
}

.wechat-icon {
  background: linear-gradient(135deg, rgba(201, 169, 110, 0.15) 0%, rgba(201, 169, 110, 0.08) 100%);
}

.other-icon {
  background: linear-gradient(135deg, rgba(201, 169, 110, 0.15) 0%, rgba(201, 169, 110, 0.08) 100%);
}

.contact-icon-img {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.7;
}

.contact-icon-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.contact-content {
  flex: 1;
}

.contact-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
  font-size: 24rpx;
  color: #666666;
}

.primary-tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  background: linear-gradient(135deg, #C9A96E 0%, #A68B4B 100%);
  color: #FFFFFF;
  font-size: 18rpx;
  border-radius: 8rpx;
  letter-spacing: 1rpx;
}

.contact-value {
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.contact-action {
  flex-shrink: 0;
}

.contact-actions {
  display: flex;
  gap: 16rpx;
  flex-shrink: 0;
}

.action-btn-wrap {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, rgba(201, 169, 110, 0.15) 0%, rgba(201, 169, 110, 0.08) 100%);
  border-radius: 24rpx;
  transition: all 0.3s ease;
}

.action-btn-wrap:active {
  background: linear-gradient(135deg, rgba(201, 169, 110, 0.25) 0%, rgba(201, 169, 110, 0.15) 100%);
}

.qrcode-btn {
  background: linear-gradient(135deg, rgba(201, 169, 110, 0.15) 0%, rgba(201, 169, 110, 0.08) 100%);
}

.action-btn {
  font-size: 24rpx;
  color: #C9A96E;
  letter-spacing: 1rpx;
}

.qrcode-btn .action-btn {
  color: #C9A96E;
}

/* 在线客服 */
.customer-service-section {
  background-color: #FFFFFF;
  padding: 40rpx 32rpx;
  margin: 0 24rpx 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.customer-service-btn {
  width: auto;
  min-width: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 48rpx;
  background: linear-gradient(135deg, #C9A96E 0%, #A68B4B 100%);
  color: #FFFFFF;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(201, 169, 110, 0.3);
}

.customer-service-btn::after {
  border: none;
}

.btn-icon-img {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.btn-text {
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  color: #FFFFFF;
  white-space: nowrap;
}

/* 地图 */
.map-section {
  background-color: #FFFFFF;
  padding: 40rpx 32rpx;
  margin: 0 24rpx 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
}

.store-map {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.empty-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(201, 169, 110, 0.15) 0%, rgba(201, 169, 110, 0.08) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-icon {
  width: 60rpx;
  height: 60rpx;
  opacity: 0.6;
}

.empty-text {
  color: #999999;
  font-size: 28rpx;
  letter-spacing: 1rpx;
}

/* 温馨提示 */
.tips-section {
  background-color: #FFFFFF;
  padding: 32rpx;
  margin: 0 24rpx 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
}

.tips-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.tips-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
}

.tips-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1A1A1A;
  letter-spacing: 1rpx;
}

.tips-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tip-item {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
  letter-spacing: 1rpx;
  padding-left: 24rpx;
  position: relative;
}

.tip-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 12rpx;
  width: 8rpx;
  height: 8rpx;
  background: #C9A96E;
  border-radius: 50%;
}
