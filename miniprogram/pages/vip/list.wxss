.page-container {
  min-height: 100vh;
  background-color: #FAFAFA;
  padding-bottom: env(safe-area-inset-bottom);
}

.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  background-color: #FFFFFF;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  letter-spacing: 2rpx;
}

.primary-tabs {
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
}

.tabs-scroll {
  white-space: nowrap;
}

.tabs-list {
  display: inline-flex;
  padding: 0 16rpx;
}

.tab-item {
  padding: 24rpx 20rpx;
}

.tab-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.tab-name {
  font-size: 30rpx;
  color: #666666;
  letter-spacing: 1rpx;
}

.tab-item.active .tab-name {
  color: #1A1A1A;
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: -24rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: linear-gradient(135deg, #C9A96E 0%, #A68B4B 100%);
  border-radius: 3rpx;
}

.secondary-section {
  background-color: #FFFFFF;
  padding: 20rpx 0;
  margin-bottom: 24rpx;
}

.secondary-label {
  font-size: 24rpx;
  color: #999999;
  padding: 0 32rpx;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.secondary-scroll {
  white-space: nowrap;
}

.secondary-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 0 32rpx;
}

.secondary-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  color: #666666;
  background-color: #F5F5F5;
  border-radius: 28rpx;
  letter-spacing: 1rpx;
}

.secondary-item.active {
  background: linear-gradient(135deg, #C9A96E 0%, #A68B4B 100%);
  color: #FFFFFF;
  font-weight: 500;
}

.staff-section {
  padding: 0 24rpx;
}

.staff-count {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 20rpx;
  letter-spacing: 1rpx;
}

.staff-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.staff-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.staff-item:active {
  transform: scale(0.98);
}

.staff-avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 24rpx;
  flex-shrink: 0;
  border: 4rpx solid rgba(201, 169, 110, 0.2);
}

.staff-avatar {
  width: 100%;
  height: 100%;
  background-color: #f5f5f5;
}

.staff-info {
  flex: 1;
  min-width: 0;
}

.staff-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.staff-name {
  font-size: 32rpx;
  color: #1A1A1A;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.staff-title {
  font-size: 22rpx;
  color: #C9A96E;
  background: linear-gradient(135deg, rgba(201, 169, 110, 0.12) 0%, rgba(201, 169, 110, 0.06) 100%);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.staff-exp {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.staff-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.staff-tag {
  font-size: 22rpx;
  color: #999999;
  background-color: #F5F5F5;
  padding: 6rpx 14rpx;
  border-radius: 6rpx;
}

.staff-arrow {
  padding-left: 16rpx;
}

.arrow-icon {
  font-size: 28rpx;
  color: #CCCCCC;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(201, 169, 110, 0.15) 0%, rgba(201, 169, 110, 0.08) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-icon-text {
  font-size: 40rpx;
  color: #C9A96E;
}

.empty-text {
  color: #666666;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}

.empty-hint {
  color: #999999;
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  gap: 16rpx;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(201, 169, 110, 0.2);
  border-top-color: #C9A96E;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  color: #999999;
  font-size: 26rpx;
  letter-spacing: 1rpx;
}

.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 0;
  gap: 24rpx;
}

.no-more-line {
  width: 60rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent 0%, #EAEAEA 50%, transparent 100%);
}

.no-more-text {
  color: #999999;
  font-size: 24rpx;
  letter-spacing: 1rpx;
}
