<view class="page-container">
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:if="{{staff && !loading}}">
    <view class="staff-header">
      <view class="avatar-wrap">
        <image class="staff-avatar" src="{{staff.avatar || '/images/default-avatar.png'}}" mode="aspectFill"></image>
      </view>
      <view class="staff-info">
        <view class="staff-name-row">
          <text class="staff-name">{{staff.name}}</text>
          <text class="staff-title" wx:if="{{staff.title}}">{{staff.title}}</text>
        </view>
        <view class="staff-exp" wx:if="{{staff.experience}}">从业{{staff.experience}}</view>
        <view class="staff-type" wx:if="{{staff.typeInfo}}">{{staff.typeInfo.name}}</view>
      </view>
    </view>

    <view class="intro-section" wx:if="{{staff.introduction}}">
      <view class="section-label">个人简介</view>
      <view class="intro-content">{{staff.introduction}}</view>
    </view>

    <view class="staff-works-section" wx:if="{{staffWorks.length > 0}}">
      <view class="section-label">关联作品</view>
      <view class="staff-works-list">
        <view class="staff-work-card" wx:for="{{staffWorks}}" wx:key="_id" bindtap="onStaffWorkTap" data-item="{{item}}">
          <image class="staff-work-cover" src="{{item.workCover}}" mode="aspectFill"></image>
          <view class="staff-work-info">
            <text class="staff-work-title">{{item.workTitle}}</text>
            <text class="staff-work-type">{{item.workType === 'wedding_photo' ? '婚纱摄影' : '现场布置'}}</text>
          </view>
          <text class="staff-work-arrow">›</text>
        </view>
      </view>
    </view>
  </block>
</view>
