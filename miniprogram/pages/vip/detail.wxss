.page-container {
  min-height: 100vh;
  background-color: #FAFAFA;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid rgba(17, 17, 17, 0.1);
  border-top-color: #111111;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 24rpx;
  color: #999999;
  font-size: 24rpx;
  letter-spacing: 4rpx;
}

.staff-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx 80rpx;
  background-color: #FFFFFF;
  margin-bottom: 2rpx;
}

.avatar-wrap {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-bottom: 40rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
}

.staff-avatar {
  width: 100%;
  height: 100%;
  background-color: #FAFAFA;
  object-fit: cover;
}

.staff-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.staff-name-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.staff-name {
  font-family: 'Times New Roman', Times, serif;
  font-size: 48rpx;
  color: #111111;
  font-weight: 400;
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
}

.staff-title {
  font-size: 20rpx;
  color: #B89C6D;
  background-color: #FDFCF8;
  padding: 8rpx 20rpx;
  border-radius: 4rpx;
  border: 1rpx solid rgba(184, 156, 109, 0.3);
  letter-spacing: 2rpx;
}

.staff-exp, .staff-type {
  font-size: 24rpx;
  color: #666666;
  letter-spacing: 2rpx;
  font-weight: 300;
  margin-bottom: 8rpx;
}

.intro-section,
.staff-works-section {
  background-color: #FFFFFF;
  padding: 80rpx 40rpx;
  margin-bottom: 2rpx;
}

.section-label {
  font-size: 32rpx;
  color: #111111;
  font-weight: 400;
  letter-spacing: 4rpx;
  margin-bottom: 40rpx;
  text-align: center;
}

.intro-content {
  font-size: 26rpx;
  color: #666666;
  line-height: 2.2;
  letter-spacing: 2rpx;
  font-weight: 300;
  text-align: justify;
}

.staff-works-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.staff-work-card {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background-color: #FAFAFA;
  border: 1rpx solid rgba(0,0,0,0.03);
  transition: all 0.3s ease;
}

.staff-work-card:active {
  background-color: #F5F5F5;
  transform: translateY(-2rpx);
}

.staff-work-cover {
  width: 160rpx;
  height: 160rpx;
  margin-right: 30rpx;
  background-color: #E8E8E8;
  object-fit: cover;
}

.staff-work-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.staff-work-title {
  font-size: 28rpx;
  color: #111111;
  font-weight: 400;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.staff-work-type {
  font-size: 22rpx;
  color: #999999;
  letter-spacing: 2rpx;
  font-weight: 300;
}

.staff-work-arrow {
  font-size: 40rpx;
  color: #DDDDDD;
  font-weight: 300;
}
