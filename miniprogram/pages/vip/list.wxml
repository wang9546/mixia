<view class="page-container">
  <view class="filter-header">
    <view class="header-title">四大金刚</view>
  </view>

  <view class="primary-tabs">
    <scroll-view class="tabs-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="tabs-list">
        <view 
          class="tab-item {{activeType === item.id ? 'active' : ''}}" 
          wx:for="{{types}}" 
          wx:key="id"
          bindtap="onTypeChange"
          data-id="{{item.id}}"
        >
          <view class="tab-content">
            <text class="tab-name">{{item.name}}</text>
            <view class="tab-indicator" wx:if="{{activeType === item.id}}"></view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="staff-section">
    <view class="staff-count" wx:if="{{total > 0}}">共 {{total}} 位服务人员</view>
    
    <view class="staff-list" wx:if="{{staffList.length > 0}}">
      <view class="staff-item" wx:for="{{staffList}}" wx:key="_id" bindtap="onStaffTap" data-id="{{item._id}}">
        <view class="staff-avatar-wrap">
          <image class="staff-avatar" src="{{item.avatar || '/images/default-avatar.png'}}" mode="aspectFill"></image>
        </view>
        <view class="staff-info">
          <view class="staff-header">
            <text class="staff-name">{{item.name}}</text>
            <text class="staff-title" wx:if="{{item.title}}">{{item.title}}</text>
          </view>
          <view class="staff-exp" wx:if="{{item.experience}}">从业{{item.experience}}</view>
          <view class="staff-tags" wx:if="{{item.typeInfo}}">
            <text class="staff-tag">{{item.typeInfo.name}}</text>
          </view>
        </view>
        <view class="staff-arrow">
          <text class="arrow-icon">→</text>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{!loading && staffList.length === 0}}">
      <view class="empty-icon-wrap">
        <text class="empty-icon-text">◈</text>
      </view>
      <text class="empty-text">暂无服务人员</text>
      <text class="empty-hint">换个筛选条件试试吧</text>
    </view>

    <view class="loading-more" wx:if="{{loadingMore}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <view class="no-more" wx:if="{{noMore && staffList.length > 0}}">
      <view class="no-more-line"></view>
      <text class="no-more-text">已经到底了</text>
      <view class="no-more-line"></view>
    </view>
  </view>
</view>
