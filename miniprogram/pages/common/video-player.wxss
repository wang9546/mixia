.video-container {
  width: 100%;
  height: 100vh;
  background-color: #000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.video-player {
  width: 100%;
  height: 100%;
}

.loading-container,
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
}

.loading-spinner {
  width: 40px;
  height: 40px;
  border: 3px solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  margin-top: 16px;
  font-size: 14px;
  color: rgba(255, 255, 255, 0.8);
}

.error-icon {
  font-size: 48px;
  margin-bottom: 16px;
}

.error-text {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 24px;
}

.retry-btn {
  background: #C9A96E;
  color: #fff;
  font-size: 14px;
  padding: 10px 32px;
  border-radius: 20px;
  border: none;
}

.retry-btn::after {
  border: none;
}

.download-container {
  width: 100%;
  height: 100%;
  position: relative;
}

.download-poster {
  width: 100%;
  height: 100%;
  background-color: #222;
}

.download-poster.placeholder {
  background: linear-gradient(135deg, #333 0%, #222 100%);
}

.download-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.5);
}

.progress-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24px 40px;
  background: rgba(0, 0, 0, 0.7);
  border-radius: 12px;
}

.progress-bar {
  width: 200px;
  height: 6px;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 3px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #C9A96E 0%, #A68B4B 100%);
  border-radius: 3px;
  transition: width 0.3s ease;
}

.progress-text {
  color: #fff;
  font-size: 14px;
  margin-top: 12px;
}
