<view class="video-container">
  <view wx:if="{{loading}}" class="loading-container">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>
  
  <view wx:elif="{{error}}" class="error-container">
    <text class="error-icon">⚠️</text>
    <text class="error-text">{{error}}</text>
    <button class="retry-btn" bindtap="onRetry">重试</button>
  </view>
  
  <view wx:elif="{{isDownloading}}" class="download-container">
    <image class="download-poster" src="{{poster}}" mode="aspectFill" wx:if="{{poster}}"></image>
    <view class="download-poster placeholder" wx:else></view>
    <view class="download-overlay">
      <view class="progress-wrap">
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{downloadProgress}}%"></view>
        </view>
        <text class="progress-text">{{downloadProgress}}%</text>
      </view>
    </view>
  </view>
  
  <video 
    wx:else
    id="myVideo"
    class="video-player"
    src="{{videoUrl}}"
    poster="{{poster}}"
    controls="{{true}}"
    show-center-play-btn="{{true}}"
    object-fit="contain"
    autoplay="{{true}}"
    binderror="onVideoError"
  ></video>
</view>
