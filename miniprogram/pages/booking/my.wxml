<view class="page-container">
  <view class="filter-section">
    <scroll-view class="filter-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="filter-list">
        <view 
          class="filter-item {{statusFilter === item.id ? 'active' : ''}}" 
          wx:for="{{statusOptions}}" 
          wx:key="id"
          bindtap="onStatusChange"
          data-id="{{item.id}}"
        >
          {{item.name}}
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="booking-list" wx:if="{{bookings.length > 0}}">
    <view 
      class="booking-item" 
      wx:for="{{bookings}}" 
      wx:key="_id"
      bindtap="onBookingTap"
      data-id="{{item._id}}"
    >
      <view class="booking-header">
        <view class="booking-no">预约编号：{{item.orderNo}}</view>
        <view class="booking-status {{item.statusClass}}">
          {{item.statusText}}
        </view>
      </view>
      
      <view class="booking-content">
        <view class="info-row">
          <text class="info-label">预约日期</text>
          <text class="info-value">{{item.bookingDate}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">联系人</text>
          <text class="info-value">{{item.groomName}} & {{item.brideName}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">联系电话</text>
          <text class="info-value">{{item.phone}}</text>
        </view>
        <view class="info-row" wx:if="{{item.remark}}">
          <text class="info-label">备注</text>
          <text class="info-value">{{item.remark}}</text>
        </view>
      </view>
      
      <view class="booking-footer">
        <text class="booking-time">预约时间：{{item.createTime}}</text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{!loading && bookings.length === 0}}">
    <view class="empty-icon-wrap">
      <text class="empty-icon-text">✦</text>
    </view>
    <text class="empty-text">暂无预约记录</text>
  </view>

  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <view class="loading-more" wx:if="{{loadingMore}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <view class="no-more" wx:if="{{noMore && bookings.length > 0}}">
    <view class="no-more-line"></view>
    <text class="no-more-text">已经到底了</text>
    <view class="no-more-line"></view>
  </view>
</view>
