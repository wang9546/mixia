.page-container {
  min-height: 100vh;
  background-color: #FAFAFA;
  padding-bottom: 160rpx;
}

.status-section {
  background: linear-gradient(135deg, #2A2A2A 0%, #1A1A1A 100%);
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.status-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(201, 169, 110, 0.2) 0%, rgba(201, 169, 110, 0.1) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.status-icon {
  font-size: 48rpx;
  color: #C9A96E;
}

.status-text {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.status-pending {
  color: #FAAD14;
}

.status-confirmed {
  color: #52C41A;
}

.status-completed {
  color: #C9A96E;
}

.status-cancelled {
  color: #999999;
}

.status-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 1rpx;
}

.info-section {
  background-color: #FFFFFF;
  padding: 32rpx;
  margin: 0 24rpx 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.section-icon {
  font-size: 28rpx;
  color: #C9A96E;
  margin-right: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  letter-spacing: 2rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #999999;
  letter-spacing: 1rpx;
}

.info-value {
  font-size: 28rpx;
  color: #1A1A1A;
  letter-spacing: 1rpx;
  text-align: right;
  flex: 1;
  margin-left: 24rpx;
}

.info-value.primary {
  color: #C9A96E;
}

.admin-remark {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
  letter-spacing: 1rpx;
  padding: 16rpx 0;
}

.time-section {
  background-color: #FFFFFF;
  padding: 24rpx 32rpx;
  margin: 0 24rpx;
  border-radius: 20rpx;
}

.time-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.time-label {
  font-size: 24rpx;
  color: #999999;
  letter-spacing: 1rpx;
}

.time-value {
  font-size: 24rpx;
  color: #666666;
  letter-spacing: 1rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx;
  background-color: #FFFFFF;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.cancel-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background-color: #FFFFFF;
  color: #666666;
  font-size: 30rpx;
  border-radius: 48rpx;
  border: 2rpx solid #EAEAEA;
  letter-spacing: 2rpx;
}

.cancel-btn::after {
  border: none;
}

.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background-color: #FAFAFA;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(201, 169, 110, 0.2);
  border-top-color: #C9A96E;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  color: #999999;
  font-size: 28rpx;
  letter-spacing: 1rpx;
}
