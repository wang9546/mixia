.page-container {
  min-height: 100vh;
  background-color: #FAFAFA;
  padding-bottom: env(safe-area-inset-bottom);
}

.filter-section {
  background-color: #FFFFFF;
  padding: 24rpx 0;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.filter-scroll {
  white-space: nowrap;
  padding: 0 32rpx;
}

.filter-list {
  display: inline-flex;
  gap: 16rpx;
}

.filter-item {
  display: inline-block;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  color: #666666;
  background-color: #F5F5F5;
  border-radius: 32rpx;
  letter-spacing: 1rpx;
  transition: all 0.3s ease;
  border: 1rpx solid transparent;
}

.filter-item.active {
  background: linear-gradient(135deg, rgba(201, 169, 110, 0.15) 0%, rgba(201, 169, 110, 0.08) 100%);
  color: #A68B4B;
  border-color: rgba(201, 169, 110, 0.3);
  font-weight: 500;
}

.booking-list {
  padding: 24rpx;
}

.booking-item {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
  transition: all 0.3s ease;
}

.booking-item:active {
  transform: scale(0.99);
}

.booking-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.booking-no {
  font-size: 24rpx;
  color: #999999;
  letter-spacing: 1rpx;
}

.booking-status {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.status-pending {
  background: linear-gradient(135deg, rgba(250, 173, 20, 0.15) 0%, rgba(250, 173, 20, 0.08) 100%);
  color: #D48806;
}

.status-confirmed {
  background: linear-gradient(135deg, rgba(82, 196, 26, 0.15) 0%, rgba(82, 196, 26, 0.08) 100%);
  color: #389E0D;
}

.status-completed {
  background: linear-gradient(135deg, rgba(201, 169, 110, 0.15) 0%, rgba(201, 169, 110, 0.08) 100%);
  color: #A68B4B;
}

.status-cancelled {
  background-color: rgba(153, 153, 153, 0.1);
  color: #999999;
}

.booking-content {
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.info-label {
  font-size: 26rpx;
  color: #999999;
  letter-spacing: 1rpx;
}

.info-value {
  font-size: 26rpx;
  color: #1A1A1A;
  letter-spacing: 1rpx;
}

.booking-footer {
  padding-top: 16rpx;
  border-top: 1rpx solid #F5F5F5;
}

.booking-time {
  font-size: 22rpx;
  color: #CCCCCC;
  letter-spacing: 1rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.empty-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(201, 169, 110, 0.15) 0%, rgba(201, 169, 110, 0.08) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-icon-text {
  font-size: 40rpx;
  color: #C9A96E;
}

.empty-text {
  color: #999999;
  font-size: 28rpx;
  letter-spacing: 1rpx;
}

.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  gap: 16rpx;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(201, 169, 110, 0.2);
  border-top-color: #C9A96E;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  color: #999999;
  font-size: 26rpx;
  letter-spacing: 1rpx;
}

.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 0;
  gap: 24rpx;
}

.no-more-line {
  width: 60rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent 0%, #EAEAEA 50%, transparent 100%);
}

.no-more-text {
  color: #999999;
  font-size: 24rpx;
  letter-spacing: 1rpx;
}
