.page-container {
  min-height: 100vh;
  background-color: #F8F8F8;
  padding-bottom: env(safe-area-inset-bottom);
}

.page-header {
  background: linear-gradient(135deg, #2A2A2A 0%, #1A1A1A 100%);
  padding: 64rpx 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.page-header::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(201, 169, 110, 0.08) 0%, transparent 70%);
  animation: rotate 25s linear infinite;
}

@keyframes rotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
  text-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

.header-subtitle {
  font-size: 20rpx;
  color: #C9A96E;
  letter-spacing: 6rpx;
  font-weight: 500;
  position: relative;
  z-index: 1;
}

.form-section {
  background-color: #FFFFFF;
  padding: 40rpx 36rpx;
  margin: 28rpx 28rpx 0;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.06);
  position: relative;
  overflow: hidden;
}

.form-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(201, 169, 110, 0.3), transparent);
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.section-icon {
  font-size: 28rpx;
  color: #C9A96E;
  margin-right: 14rpx;
  text-shadow: 0 4rpx 16rpx rgba(201, 169, 110, 0.3);
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: 2rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
  transition: all 0.3s ease;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item.textarea-item {
  flex-direction: column;
  align-items: flex-start;
}

.form-item:active {
  background-color: rgba(201, 169, 110, 0.02);
}

.form-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #1A1A1A;
  font-weight: 600;
  flex-shrink: 0;
  letter-spacing: 1rpx;
}

.form-label.required::before {
  content: '*';
  color: #CF1322;
  margin-right: 6rpx;
}

.form-input {
  flex: 1;
  font-size: 26rpx;
  color: #1A1A1A;
  letter-spacing: 1rpx;
}

.input-placeholder {
  color: #CCCCCC;
}

.form-picker {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-value {
  font-size: 26rpx;
  color: #1A1A1A;
  letter-spacing: 1rpx;
}

.form-picker.placeholder .picker-value {
  color: #CCCCCC;
}

.picker-arrow {
  font-size: 28rpx;
  color: #CCCCCC;
  transition: transform 0.3s ease;
}

.form-textarea {
  width: 100%;
  min-height: 180rpx;
  margin-top: 20rpx;
  padding: 24rpx;
  font-size: 26rpx;
  color: #1A1A1A;
  background-color: #F8F8F8;
  border-radius: 16rpx;
  letter-spacing: 1rpx;
  line-height: 1.8;
  border: 1rpx solid #F0F0F0;
  transition: all 0.3s ease;
}

.form-textarea:focus {
  background-color: #FFFFFF;
  border-color: rgba(201, 169, 110, 0.3);
  box-shadow: 0 4rpx 16rpx rgba(201, 169, 110, 0.1);
}

.submit-section {
  padding: 48rpx 36rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #C9A96E 0%, #A68B4B 100%);
  color: #FFFFFF;
  border-radius: 48rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 40rpx rgba(201, 169, 110, 0.35);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.submit-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  transition: left 0.6s;
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  transform: scale(0.96);
  box-shadow: 0 8rpx 32rpx rgba(201, 169, 110, 0.25);
}

.submit-btn:active::before {
  left: 100%;
}

.submit-btn.disabled {
  background: linear-gradient(135deg, #CCCCCC 0%, #AAAAAA 100%);
  box-shadow: none;
}

.btn-text {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.my-bookings-link {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 32rpx;
  padding: 20rpx;
  transition: all 0.3s ease;
}

.link-text {
  font-size: 26rpx;
  color: #C9A96E;
  letter-spacing: 1rpx;
  font-weight: 500;
}

.link-arrow {
  font-size: 28rpx;
  color: #C9A96E;
  margin-left: 10rpx;
  transition: transform 0.3s ease;
}

.my-bookings-link:active {
  transform: scale(0.98);
}

.my-bookings-link:active .link-arrow {
  transform: translateX(8rpx);
}
