<view class="page-container" wx:if="{{!loading && info}}">
  <view class="media-section">
    <image 
      wx:if="{{info.coverImage}}"
      class="main-image" 
      src="{{info.coverImage}}" 
      mode="aspectFill"
      bindtap="onImageTap"
      data-index="0"
    ></image>
    
    <swiper 
      wx:elif="{{info.images && info.images.length > 0}}"
      class="image-swiper" 
      indicator-dots="{{info.images.length > 1}}"
      indicator-color="rgba(255,255,255,0.4)"
      indicator-active-color="#C9A96E"
      circular="{{true}}"
    >
      <swiper-item wx:for="{{info.images}}" wx:key="index">
        <image 
          class="main-image" 
          src="{{item}}" 
          mode="aspectFill"
          bindtap="onImageTap"
          data-index="{{index}}"
        ></image>
      </swiper-item>
    </swiper>
  </view>

  <view class="info-section">
    <view class="info-header">
      <view class="info-title">{{info.title}}</view>
      <view class="info-tags">
        <text class="tag tag-gold" wx:if="{{info.typeInfo}}">{{info.typeInfo.name}}</text>
        <text class="tag tag-gray" wx:for="{{info.tagInfos}}" wx:key="_id">{{item.name}}</text>
      </view>
    </view>
  </view>

  <view class="detail-section" wx:if="{{info.remark}}">
    <view class="section-header">
      <text class="section-subtitle">DESCRIPTION</text>
      <text class="section-title">布置介绍</text>
    </view>
    <view class="desc-content">{{info.remark}}</view>
  </view>

  <view class="detail-section" wx:if="{{videos.length > 0}}">
    <view class="section-header">
      <text class="section-subtitle">VIDEO</text>
      <text class="section-title">布置视频</text>
    </view>
    <view class="videos-container">
      <view class="video-item" wx:for="{{videos}}" wx:key="index">
        <video 
          class="detail-video" 
          src="{{item}}" 
          controls="{{true}}"
          show-center-play-btn="{{true}}"
          enable-progress-gesture="{{true}}"
          enable-play-gesture="{{true}}"
          object-fit="cover"
        ></video>
      </view>
    </view>
  </view>

  <view class="detail-section" wx:if="{{info.images && info.images.length > 0}}">
    <view class="section-header">
      <text class="section-subtitle">GALLERY</text>
      <text class="section-title">布置图片</text>
    </view>
    <view class="gallery-grid">
      <view 
        class="gallery-item" 
        wx:for="{{info.images}}" 
        wx:key="index"
        bindtap="onImageTap"
        data-index="{{index}}"
      >
        <image class="gallery-image" src="{{item}}" mode="aspectFill"></image>
        <view class="gallery-overlay">
          <text class="gallery-index">{{index + 1}}/{{info.images.length}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-bar safe-area-bottom">
    <button class="booking-btn btn-primary" bindtap="onBookingTap">
      立即咨询
    </button>
  </view>
</view>

<view class="loading-container" wx:if="{{loading}}">
  <view class="loading-content">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>
</view>

<float-service />
