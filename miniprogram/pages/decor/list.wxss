.page-container {
  min-height: 100vh;
  background-color: #FAFAFA;
  padding-bottom: env(safe-area-inset-bottom);
}

.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  background-color: #FFFFFF;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  letter-spacing: 2rpx;
}

.sort-tabs {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.sort-tab {
  font-size: 26rpx;
  color: #999999;
  letter-spacing: 1rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.sort-tab.active {
  color: #C9A96E;
  background: linear-gradient(135deg, rgba(201, 169, 110, 0.15) 0%, rgba(201, 169, 110, 0.08) 100%);
  font-weight: 500;
}

.sort-divider {
  width: 1rpx;
  height: 24rpx;
  background-color: #E5E5E5;
}

.filter-section {
  background-color: #FFFFFF;
  padding: 20rpx 0;
  margin-bottom: 24rpx;
}

.filter-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.filter-label {
  font-size: 24rpx;
  color: #999999;
  width: 100rpx;
  padding-left: 32rpx;
  flex-shrink: 0;
}

.filter-scroll {
  flex: 1;
  white-space: nowrap;
}

.filter-list {
  display: inline-flex;
  gap: 16rpx;
  padding-right: 32rpx;
}

.filter-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  color: #666666;
  background-color: #F5F5F5;
  border-radius: 28rpx;
  letter-spacing: 1rpx;
}

.filter-item.active {
  background: linear-gradient(135deg, #C9A96E 0%, #A68B4B 100%);
  color: #FFFFFF;
  font-weight: 500;
}

.list-section {
  padding: 0 24rpx;
}

.list-count {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 20rpx;
  letter-spacing: 1rpx;
}

.list-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.list-item {
  width: 100%;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.list-item:active {
  transform: scale(0.98);
}

.item-cover-wrap {
  position: relative;
  width: 100%;
  height: 320rpx;
  overflow: hidden;
}

.item-cover {
  width: 100%;
  height: 100%;
  background-color: #f5f5f5;
}

.item-cover-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 40%;
  background: linear-gradient(to top, rgba(0,0,0,0.12) 0%, transparent 100%);
  pointer-events: none;
}

.item-info {
  padding: 20rpx;
}

.item-title {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.item-meta {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.item-style {
  font-size: 22rpx;
  color: #C9A96E;
  background: linear-gradient(135deg, rgba(201, 169, 110, 0.12) 0%, rgba(201, 169, 110, 0.06) 100%);
  padding: 6rpx 14rpx;
  border-radius: 6rpx;
}

.item-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 24rpx;
  color: #C9A96E;
  font-weight: 500;
}

.price-num {
  font-size: 32rpx;
  color: #C9A96E;
  font-weight: 600;
}

.price-unit {
  font-size: 22rpx;
  color: #999999;
  margin-left: 4rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(201, 169, 110, 0.15) 0%, rgba(201, 169, 110, 0.08) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-icon-text {
  font-size: 40rpx;
}

.empty-text {
  color: #666666;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}

.empty-hint {
  color: #999999;
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  gap: 16rpx;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(201, 169, 110, 0.2);
  border-top-color: #C9A96E;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  color: #999999;
  font-size: 26rpx;
  letter-spacing: 1rpx;
}

.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 0;
  gap: 24rpx;
}

.no-more-line {
  width: 60rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent 0%, #EAEAEA 50%, transparent 100%);
}

.no-more-text {
  color: #999999;
  font-size: 24rpx;
  letter-spacing: 1rpx;
}
