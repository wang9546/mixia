/* ── 联系页 · 极简雅白 ── */

.contact-container {
  padding:        0;
  min-height:     100vh;
  background:     var(--paper);
  padding-bottom: 60rpx;
}

/* ─── 轮播图 ─── */
.store-swiper-wrap {
  width:      100%;
  height:     440rpx;
  background: #E8E4DE;
  position:   relative;
  overflow:   hidden;
}

.store-swiper {
  width:  100%;
  height: 100%;
}

.store-image {
  width:  100%;
  height: 100%;
}

.swiper-overlay {
  position:   absolute;
  inset:      0;
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.12) 0%,
    rgba(0, 0, 0, 0.42) 100%
  );
}

/* 角标装饰：不显示 */
.swiper-corner-decor { display: none; }

/* ─── 内容区域 ─── */
.info-section {
  padding:    32rpx var(--margin-page) 0;
  margin-top: -44rpx;
  position:   relative;
  z-index:    2;
}

/* ─── 品牌卡片 ─── */
.basic-card {
  text-align:    center;
  padding:       48rpx 40rpx 44rpx;
  margin-bottom: 16rpx;
  background:    var(--white);
  border-radius: var(--border-radius-card);
  box-shadow:    var(--shadow-elevated);
  border:        1rpx solid var(--rule);
  position:      relative;
  overflow:      hidden;
}

.basic-card::before {
  content:    '';
  position:   absolute;
  top: 0; left: 0; right: 0;
  height:     1rpx;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
  opacity:    0.30;
}

/* 品牌标题区 */
.store-header {
  display:         flex;
  align-items:     center;
  justify-content: center;
  gap:             16rpx;
  margin-bottom:   10rpx;
}

/* 品牌名两侧装饰线 */
.store-decoration {
  display:     flex;
  align-items: center;
  gap:         8rpx;
}

/* 圆点：不显示 */
.decor-dot { display: none; }

.decor-line {
  width:      36rpx;
  height:     1rpx;
  background: linear-gradient(90deg, transparent, rgba(0, 0, 0, 0.12));
  opacity:    1;
}

.store-name {
  font-size:      44rpx;
  font-weight:    300;
  color:          var(--ink);
  letter-spacing: 10rpx;
  text-indent:    10rpx;
}

.store-subtitle {
  font-size:      17rpx;
  color:          var(--dust);
  letter-spacing: 12rpx;
  text-indent:    12rpx;
  text-transform: uppercase;
  margin-bottom:  18rpx;
}

.store-desc {
  font-size:      25rpx;
  color:          var(--stone);
  line-height:    1.75;
  letter-spacing: 1rpx;
}

/* ─── 联系信息卡片 ─── */
.contact-card {
  padding:       24rpx 32rpx;
  background:    var(--white);
  border-radius: var(--border-radius-card);
  box-shadow:    var(--shadow-card);
  border:        1rpx solid var(--rule);
  position:      relative;
  overflow:      hidden;
}

.contact-card::before {
  content:    '';
  position:   absolute;
  top: 0; left: 0; right: 0;
  height:     1rpx;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
  opacity:    0.25;
}

.contact-item {
  display:     flex;
  align-items: center;
  padding:     28rpx 0;
}

/* 图标圆圈 */
.icon-wrap {
  width:           48rpx;
  height:          48rpx;
  display:         flex;
  align-items:     center;
  justify-content: center;
  border-radius:   50%;
  margin-right:    20rpx;
  border:          1rpx solid var(--rule);
  background:      var(--paper);
  flex-shrink:     0;
}

/* 各图标类型统一白底 */
.icon-wrap.location,
.icon-wrap.phone,
.icon-wrap.wechat,
.icon-wrap.hours,
.icon-wrap.online {
  background: var(--paper);
}

.icon-symbol {
  font-size: 16rpx;
  color:     var(--gold);
}

.item-content {
  flex: 1;
}

.item-title {
  font-size:      20rpx;
  color:          var(--dust);
  margin-bottom:  6rpx;
  letter-spacing: 2rpx;
}

.item-desc {
  font-size:      27rpx;
  color:          var(--ink);
  font-weight:    400;
  letter-spacing: 1rpx;
}

.phone-text {
  color: var(--gold);
}

/* 操作按钮 */
.action-btn-wrap {
  display:       flex;
  align-items:   center;
  gap:           6rpx;
  padding:       9rpx 18rpx;
  border-radius: 20rpx;
  border:        1rpx solid var(--rule);
  background:    var(--paper);
  flex-shrink:   0;
}

/* button 元素覆写 */
.contact-btn {
  margin:        0;
  padding:       9rpx 18rpx;
  background:    var(--paper);
  border-radius: 20rpx;
  border:        1rpx solid var(--rule) !important;
  line-height:   1;
  width:         auto !important;
  min-width:     auto !important;
  max-width:     none !important;
  display:       inline-flex !important;
  align-items:   center;
  gap:           6rpx;
  font-size:     inherit;
  text-align:    left;
  box-sizing:    border-box;
  flex-shrink:   0;
}

.contact-btn::after { border: none; }
button.contact-btn  { width: auto !important; min-width: auto !important; }

.action-text {
  font-size:      21rpx;
  color:          var(--stone);
  letter-spacing: 2rpx;
}

.action-arrow {
  font-size: 17rpx;
  color:     var(--dust);
}

/* 分隔线 */
.contact-divider {
  height:     1rpx;
  background: var(--rule);
  margin:     0;
}

/* ─── 页脚细线 ─── */
.footer-decoration {
  display:         flex;
  align-items:     center;
  justify-content: center;
  gap:             20rpx;
  padding:         56rpx 0 40rpx;
}

.footer-line {
  width:      56rpx;
  height:     1rpx;
  background: linear-gradient(90deg, transparent, rgba(0, 0, 0, 0.12), transparent);
}

.footer-dot { display: none; }

/* ─── 底部按钮 ─── */
.bottom-action {
  position:  fixed;
  bottom:    0;
  left:      0;
  right:     0;
  height:    120rpx;
  background: var(--white);
  display:   flex;
  align-items: center;
  justify-content: center;
  padding:   0 var(--margin-page);
  border-top: 1rpx solid var(--rule);
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  z-index:   100;
}

.primary-btn {
  width:           100%;
  height:          88rpx;
  background:      var(--ink);
  color:           #FFFFFF;
  border-radius:   var(--border-radius-lg);
  font-size:       26rpx;
  font-weight:     400;
  display:         flex;
  align-items:     center;
  justify-content: center;
  gap:             10rpx;
  margin:          0;
  padding:         0;
  line-height:     1;
  letter-spacing:  4rpx;
  text-indent:     4rpx;
  border:          none !important;
}

.primary-btn::after { border: none; }

.btn-icon {
  font-size: 13rpx;
  color:     var(--gold);
}

.btn-text {
  letter-spacing: 4rpx;
}
