.page-container {
  min-height: 100vh;
  background-color: #FAFAFA;
  padding-bottom: 160rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

.media-section {
  width: 100%;
  height: 600rpx;
  background-color: #1A1A1A;
}

.image-swiper {
  width: 100%;
  height: 100%;
}

.main-image {
  width: 100%;
  height: 100%;
}

.info-section {
  background-color: #FFFFFF;
  padding: 60rpx 40rpx;
  margin-bottom: 2rpx;
}

.info-header {
  margin-bottom: 40rpx;
}

.info-title {
  font-size: 40rpx;
  font-weight: 400;
  color: #111111;
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
  line-height: 1.4;
}

.info-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  font-weight: 300;
}

.tag-gold {
  background-color: #FDFCF8;
  color: #B89C6D;
  border: 1rpx solid rgba(184, 156, 109, 0.3);
}

.tag-outline {
  background-color: transparent;
  color: #666666;
  border: 1rpx solid rgba(0,0,0,0.1);
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-top: 1rpx solid rgba(0,0,0,0.05);
  border-bottom: 1rpx solid rgba(0,0,0,0.05);
  margin-bottom: 30rpx;
}

.price-label {
  font-size: 24rpx;
  color: #666666;
  letter-spacing: 2rpx;
}

.price-value {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 28rpx;
  color: #111111;
  font-weight: 400;
}

.price-num {
  font-family: 'Times New Roman', Times, serif;
  font-size: 48rpx;
  color: #111111;
  font-weight: 400;
}

.price-unit {
  font-size: 22rpx;
  color: #999999;
  margin-left: 8rpx;
}

.info-stats {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 20rpx 0 0;
}

.stat-item {
  display: flex;
  align-items: baseline;
  margin-right: 60rpx;
}

.stat-value {
  font-family: 'Times New Roman', Times, serif;
  font-size: 32rpx;
  font-weight: 400;
  color: #111111;
  margin-right: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #999999;
  letter-spacing: 2rpx;
  font-weight: 300;
}

.stat-divider {
  display: none;
}

.detail-section {
  background-color: #FFFFFF;
  padding: 60rpx 40rpx;
  margin-bottom: 2rpx;
}

.section-header {
  display: flex;
  flex-direction: column;
  margin-bottom: 40rpx;
}

.section-subtitle {
  font-family: 'Times New Roman', Times, serif;
  font-size: 20rpx;
  color: #B89C6D;
  letter-spacing: 6rpx;
  margin-bottom: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 400;
  color: #111111;
  letter-spacing: 4rpx;
}

.desc-content {
  font-size: 26rpx;
  color: #666666;
  line-height: 2.2;
  letter-spacing: 2rpx;
  font-weight: 300;
  text-align: justify;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.feature-dot {
  color: #B89C6D;
  font-size: 20rpx;
  line-height: 2;
}

.feature-text {
  font-size: 26rpx;
  color: #444444;
  line-height: 1.8;
  letter-spacing: 2rpx;
  font-weight: 300;
}

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.gallery-item {
  width: 100%;
  aspect-ratio: 1;
  overflow: hidden;
  position: relative;
  background-color: #FAFAFA;
}

.gallery-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.gallery-overlay {
  display: none;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 40rpx;
  background-color: rgba(255,255,255,0.95);
  backdrop-filter: blur(20px);
  box-shadow: 0 -1rpx 0 rgba(0, 0, 0, 0.05);
}

.booking-btn {
  flex: 1;
}

.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background-color: #FFFFFF;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid rgba(17, 17, 17, 0.1);
  border-top-color: #111111;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  color: #999999;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  font-weight: 300;
}
