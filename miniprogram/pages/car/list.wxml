<view class="page-container">
  <view class="filter-header">
    <view class="header-title">婚车服务</view>
    <view class="sort-tabs">
      <view class="sort-tab {{sortType === 'new' ? 'active' : ''}}" bindtap="onSortChange" data-type="new">最新</view>
      <view class="sort-divider"></view>
      <view class="sort-tab {{sortType === 'hot' ? 'active' : ''}}" bindtap="onSortChange" data-type="hot">最热</view>
    </view>
  </view>

  <view class="filter-section">
    <view class="filter-row">
      <view class="filter-label">品牌</view>
      <scroll-view class="filter-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="filter-list">
          <view 
            class="filter-item {{activeBrand === item._id ? 'active' : ''}}" 
            wx:for="{{brands}}" 
            wx:key="_id"
            bindtap="onBrandChange"
            data-id="{{item._id}}"
          >
            {{item.name}}
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="filter-row">
      <view class="filter-label">颜色</view>
      <scroll-view class="filter-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="filter-list">
          <view 
            class="filter-item {{activeColor === item._id ? 'active' : ''}}" 
            wx:for="{{colors}}" 
            wx:key="_id"
            bindtap="onColorChange"
            data-id="{{item._id}}"
          >
            {{item.name}}
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="list-section">
    <view class="list-count" wx:if="{{total > 0}}">共 {{total}} 款婚车</view>
    
    <view class="list-grid" wx:if="{{list.length > 0}}">
      <view class="list-item" wx:for="{{list}}" wx:key="_id" bindtap="onItemTap" data-id="{{item._id}}">
        <view class="item-cover-wrap">
          <image class="item-cover" src="{{item.coverImage}}" mode="aspectFill"></image>
          <view class="item-cover-overlay"></view>
        </view>
        <view class="item-info">
          <view class="item-title">{{item.name}}</view>
          <view class="item-meta">
            <text class="item-brand" wx:if="{{item.brandInfo}}">{{item.brandInfo.name}}</text>
            <text class="item-color" wx:if="{{item.colorInfo}}">{{item.colorInfo.name}}</text>
          </view>
          <view class="item-price" wx:if="{{item.price}}">
            <text class="price-symbol">¥</text>
            <text class="price-num">{{item.price}}</text>
            <text class="price-unit">/{{item.priceUnit || '天'}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{!loading && list.length === 0}}">
      <view class="empty-icon-wrap">
        <text class="empty-icon-text">🚗</text>
      </view>
      <text class="empty-text">暂无相关婚车</text>
      <text class="empty-hint">换个筛选条件试试吧</text>
    </view>

    <view class="loading-more" wx:if="{{loadingMore}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <view class="no-more" wx:if="{{noMore && list.length > 0}}">
      <view class="no-more-line"></view>
      <text class="no-more-text">已经到底了</text>
      <view class="no-more-line"></view>
    </view>
  </view>

  <float-service />
</view>
