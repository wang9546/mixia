.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -4rpx 32rpx rgba(0, 0, 0, 0.06);
  z-index: 9999;
  border-top: 1rpx solid rgba(201, 169, 110, 0.1);
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  position: relative;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.tab-bar-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, #C9A96E, transparent);
  border-radius: 2rpx;
  transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.tab-bar-item.active::before {
  width: 60rpx;
}

.tab-icon {
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 6rpx;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  filter: grayscale(100%) opacity(0.5);
}

.tab-bar-item.active .tab-icon {
  filter: grayscale(0%) opacity(1);
  transform: scale(1.1);
}

.tab-text {
  font-size: 24rpx;
  line-height: 1.3;
  letter-spacing: 1rpx;
  font-weight: 500;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.tab-bar-item.active .tab-text {
  font-weight: 600;
  letter-spacing: 2rpx;
}

.tab-bar-item:active {
  transform: scale(0.95);
}

.tab-bar-item:active .tab-icon {
  transform: scale(1.15);
}
