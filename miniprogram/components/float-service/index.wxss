.float-area {
  position: fixed;
  top: 0;
  left: 0;
  pointer-events: none;
  z-index: 100;
}

.float-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
  border: 2rpx solid rgba(201, 169, 110, 0.2);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.float-btn::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  border-radius: 50%;
  background: rgba(201, 169, 110, 0.15);
  transform: translate(-50%, -50%);
  transition: width 0.6s, height 0.6s;
}

.float-btn:active {
  transform: scale(0.9);
  box-shadow: 0 12rpx 40rpx rgba(201, 169, 110, 0.25);
}

.float-btn:active::before {
  width: 200%;
  height: 200%;
}

.float-icon {
  width: 48rpx;
  height: 48rpx;
  position: relative;
  z-index: 1;
  transition: transform 0.3s ease;
}

.float-btn:active .float-icon {
  transform: scale(1.1);
}
