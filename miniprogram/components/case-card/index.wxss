.case-card {
  background-color: #FFFFFF;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.08);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.case-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 28rpx;
  padding: 2rpx;
  background: linear-gradient(135deg, rgba(201, 169, 110, 0.2), transparent);
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.4s;
}

.case-card:active {
  transform: scale(0.96) translateY(8rpx);
  box-shadow: 0 16rpx 56rpx rgba(0, 0, 0, 0.12);
}

.case-card:active::before {
  opacity: 1;
}

.case-cover-wrap {
  position: relative;
  width: 100%;
  height: 300rpx;
  overflow: hidden;
}

.case-cover {
  width: 100%;
  height: 100%;
  background-color: #f5f5f5;
  transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.case-card:active .case-cover {
  transform: scale(1.05);
}

.case-cover-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 50%;
  background: linear-gradient(to top, rgba(0,0,0,0.25) 0%, transparent 100%);
  pointer-events: none;
}

.case-info {
  padding: 28rpx;
}

.case-title {
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}

.case-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.case-type {
  font-size: 22rpx;
  color: #C9A96E;
  background: linear-gradient(135deg, rgba(201, 169, 110, 0.18) 0%, rgba(201, 169, 110, 0.08) 100%);
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(201, 169, 110, 0.25);
  font-weight: 600;
  letter-spacing: 2rpx;
}

.case-stats {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stat-icon {
  font-size: 22rpx;
  opacity: 0.5;
}

.stat-num {
  font-size: 22rpx;
  color: #999999;
  letter-spacing: 1rpx;
}
